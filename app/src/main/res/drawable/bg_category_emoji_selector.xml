<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- selected: gradient ring (outer), white center (inner) -->
    <item android:state_selected="true">
        <layer-list>
            <!-- outer gradient ring -->
            <item>
                <shape android:shape="oval">
                    <size android:width="48dp" android:height="48dp" />
                    <gradient android:startColor="#6A5ACD" android:centerColor="#FF6B8A" android:endColor="#FFB199" android:angle="0" />
                </shape>
            </item>
            <!-- inner white circle to create ring effect -->
            <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp">
                <shape android:shape="oval">
                    <solid android:color="#FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- default: white translucent circle -->
    <item>
        <shape android:shape="oval">
            <size android:width="44dp" android:height="44dp" />
            <solid android:color="@color/white_88" />
        </shape>
    </item>
</selector>