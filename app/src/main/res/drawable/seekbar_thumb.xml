<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main Body (Screen Width 24dp, Screen Height 16dp after 270 rotation) -->
    <!-- So Original Height = 24dp, Original Width = 16dp -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#EEEEEE" />
            <corners android:radius="4dp" />
            <size android:width="16dp" android:height="24dp" />
            <stroke android:width="1dp" android:color="#CCCCCC" />
        </shape>
    </item>
    <!-- Indicator Square (Small colored bit in the center) -->
    <item android:id="@+id/thumb_indicator"
          android:top="9dp" android:bottom="9dp"
          android:left="5dp" android:right="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
