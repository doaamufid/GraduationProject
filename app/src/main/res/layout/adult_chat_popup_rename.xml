<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/adult_chat_bg_popup"
    android:elevation="10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <EditText
        android:id="@+id/editRename"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:background="@drawable/adult_chat_bg_rename_input"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:singleLine="true"
        android:textColor="@color/adult_chat_text_mid"
        android:textSize="12.5sp" />

    <TextView
        android:id="@+id/btnRenameConfirm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/adult_chat_bg_cta_primary"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:text="حفظ"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
