<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/sheet_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_sheet_top_rounded"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/add_trait_dialog_title"
                android:textColor="@color/text_main"
                android:textStyle="bold"
                android:textSize="@dimen/text_title"
                android:gravity="center"/>

            <ImageButton
                android:id="@+id/btn_close_dialog"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_close"
                android:padding="4dp"
                android:contentDescription="@null"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/suggestions_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/edit_trait_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_flat"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:hint="@string/trait_name_hint"
            android:inputType="text"
            android:gravity="start"
            android:textSize="@dimen/text_body3"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_soft"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/edit_trait_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:gravity="top|end"
            android:background="@drawable/bg_input_flat"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:hint="@string/trait_note_hint"
            android:inputType="textMultiLine"
            android:textSize="@dimen/text_body3"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_soft"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btn_save_trait"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="@drawable/bg_button_primary"
            android:text="@string/save_trait_button"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="@dimen/text_title"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:enabled="false"
            android:alpha="0.4"/>

    </LinearLayout>
</FrameLayout>
