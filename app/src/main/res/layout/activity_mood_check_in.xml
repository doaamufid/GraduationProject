<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9EF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top bar: back + search -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="رجوع" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />


        </LinearLayout>

        <!-- Teddy avatar -->
        <ImageView
            android:id="@+id/imgTeddy"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:src="@drawable/teddy_avatar"
            android:contentDescription="الدبدوب" />

        <!-- Greeting bubble -->
        <TextView
            android:id="@+id/txtGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_bubble_yellow"
            android:paddingHorizontal="18dp"
            android:paddingVertical="10dp"
            android:text="أنا هنا معك دائما 💛"
            android:textSize="15sp"
            android:textColor="#5A4632" />

        <!-- Mood grid -->
        <GridLayout
            android:id="@+id/gridMoods"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:columnCount="3"
            android:rowCount="2"
            android:alignmentMode="alignMargins">

            <TextView
                android:id="@+id/moodHappy"
                style="@style/MoodItem"
                android:tag="سعيد"
                android:text="😄&#10;سعيد" />

            <TextView
                android:id="@+id/moodSad"
                style="@style/MoodItem"
                android:tag="حزين"
                android:text="😢&#10;حزين" />

            <TextView
                android:id="@+id/moodScared"
                style="@style/MoodItem"
                android:tag="خايف"
                android:text="😨&#10;خايف" />

            <TextView
                android:id="@+id/moodAngry"
                style="@style/MoodItem"
                android:tag="غضبان"
                android:text="😠&#10;غضبان" />

            <TextView
                android:id="@+id/moodTired"
                style="@style/MoodItem"
                android:tag="تعبان"
                android:text="😴&#10;تعبان" />

            <TextView
                android:id="@+id/moodUpset"
                style="@style/MoodItem"
                android:tag="محزون"
                android:text="😔&#10;مكتئب" />
        </GridLayout>

        <!-- Confirm button -->
        <Button
            android:id="@+id/btnConfirmMood"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_button_orange"
            android:enabled="false"
            android:text="تأكيد اختيار اليوم"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <!-- Category cards -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:columnCount="2"
            android:rowCount="3"
            android:alignmentMode="alignMargins">

            <TextView
                android:id="@+id/cardSafetyTeam"
                style="@style/CategoryCard"
                android:background="@drawable/bg_card_green"
                android:text="🏠&#10;فريق الأمان" />

            <TextView
                android:id="@+id/cardBreathe"
                style="@style/CategoryCard"
                android:background="@drawable/bg_card_blue"
                android:text="🫁&#10;تنفس مع الهدهاد" />

            <TextView
                android:id="@+id/cardComfort"
                style="@style/CategoryCard"
                android:background="@drawable/bg_card_purple"
                android:text="🌈&#10;البيات المريحة" />

            <TextView
                android:id="@+id/cardPlayBushes"
                style="@style/CategoryCard"
                android:background="@drawable/bg_card_orange"
                android:text="📔&#10;كلماتك القوية"/>

            <TextView
                android:id="@+id/cardVideos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnSpan="2"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_videos"
                android:gravity="center"
                android:padding="18dp"
                android:text="🎬  قصص وفيديوهات"
                android:textColor="#5A4632"
                android:textSize="17sp"
                android:textStyle="bold" />

        </GridLayout>

    </LinearLayout>
</ScrollView>