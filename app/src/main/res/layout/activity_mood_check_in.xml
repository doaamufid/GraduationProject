<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9EF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Right Side: Action Icons -->
        <LinearLayout
            android:id="@+id/ll_top_icons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Icon 1: Switch Profile (Users) -->
            <ImageButton
                android:id="@+id/btn_switch_profile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="تبديل البروفايل"
                android:padding="10dp"
                android:src="@drawable/ic_users"
                app:tint="#8B6F4D" />

            <!-- Icon 2: Switch to Adults Home (Home/Refresh) -->
            <ImageButton
                android:id="@+id/btn_switch_mode"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="تبديل الوضع"
                android:padding="10dp"
                android:src="@drawable/ic_refresh"
                app:tint="#8B6F4D" />

        </LinearLayout>

        <!-- Left Side: Back Button -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="رجوع"
            android:elevation="3dp"
            android:padding="10dp"
            android:src="@drawable/outline_arrow_forward_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#8B6F4D" />

        <!-- 🌟 الأفاتار النصي المختار -->
        <TextView
            android:id="@+id/tvChildAvatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="80dp"
            android:text="🐻"
            android:textSize="70sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Greeting bubble -->
        <TextView
            android:id="@+id/txtGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_bubble_yellow"
            android:paddingHorizontal="18dp"
            android:paddingVertical="10dp"
            android:text="أنا هنا معك دائما 💛"
            android:textColor="#5A4632"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvChildAvatar" />

        <!-- Mood grid -->
        <GridLayout
            android:id="@+id/gridMoods"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:alignmentMode="alignMargins"
            android:columnCount="3"
            android:rowCount="2"
            app:layout_constraintTop_toBottomOf="@id/txtGreeting">

            <TextView
                android:id="@+id/moodHappy"
                style="@style/MoodItem"
                android:tag="سعيد"
                android:text="😄&#10;سعيد" />

            <TextView
                android:id="@+id/moodSad"
                style="@style/MoodItem"
                android:tag="حزين"
                android:text="😢&#10;حزين" />

            <TextView
                android:id="@+id/moodScared"
                style="@style/MoodItem"
                android:tag="خايف"
                android:text="😨&#10;خايف" />

            <TextView
                android:id="@+id/moodAngry"
                style="@style/MoodItem"
                android:tag="غضبان"
                android:text="😠&#10;غضبان" />

            <TextView
                android:id="@+id/moodTired"
                style="@style/MoodItem"
                android:tag="تعبان"
                android:text="😴&#10;تعبان" />

            <TextView
                android:id="@+id/moodUpset"
                style="@style/MoodItem"
                android:tag="محزون"
                android:text="😔&#10;محزون" />
        </GridLayout>

        <!-- Confirm button -->
        <Button
            android:id="@+id/btnConfirmMood"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_button_orange"
            android:enabled="false"
            android:text="تأكيد اختيار اليوم"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/gridMoods" />

        <!-- Category cards -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:alignmentMode="alignMargins"
            android:columnCount="2"
            android:rowCount="3"
            app:layout_constraintTop_toBottomOf="@id/btnConfirmMood">

            <TextView
                android:id="@+id/cardSafetyTeam"
                style="@style/CategoryCard"
                android:background="@drawable/bg_card_green"
                android:text="🏠&#10;فريق الأمان" />

            <TextView
                android:id="@+id/cardBreathe"
                style="@style/CategoryCard"
                android:background="@drawable/bg_card_blue"
                android:text="🫁&#10;تنفس مع الهدهاد" />

            <TextView
                android:id="@+id/cardComfort"
                style="@style/CategoryCard"
                android:background="@drawable/bg_card_purple"
                android:text="🌈&#10;البيات المريحة" />

            <TextView
                android:id="@+id/cardPlayBushes"
                style="@style/CategoryCard"
                android:background="@drawable/bg_card_orange"
                android:text="🌳&#10;شجيرات اللعبة" />

            <TextView
                android:id="@+id/cardVideos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnSpan="2"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_videos"
                android:gravity="center"
                android:padding="18dp"
                android:text="🎬  قصص وفيديوهات"
                android:textColor="#5A4632"
                android:textSize="17sp"
                android:textStyle="bold" />

        </GridLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>