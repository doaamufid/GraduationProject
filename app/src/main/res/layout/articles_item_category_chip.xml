<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_marginEnd="12dp"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/category_icon_container"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:padding="3dp">

        <View
            android:id="@+id/category_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_category_ring"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txt_category_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="1.5dp"
            android:background="@drawable/bg_circle_bordered"
            android:gravity="center"
            android:textSize="24sp"
            tools:text="🌟" />
    </FrameLayout>

    <TextView
        android:id="@+id/txt_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textStyle="bold"
        android:textSize="12sp"
        android:textColor="@color/text"
        tools:text="الكل" />

</LinearLayout>
