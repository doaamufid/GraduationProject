<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@color/bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="96dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- top bar -->
            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="12dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_surface_round_stroke"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/text"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/cd_back" />

                <View android:layout_width="12dp" android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wall_title"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="@color/text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wall_sub"
                        android:textSize="11sp"
                        android:alpha="0.6"
                        android:textColor="@color/text" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <FrameLayout
                        android:id="@+id/pinnedBtn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_surface_round_stroke"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:id="@+id/pinnedBtnIcon"
                            android:src="@drawable/ic_bookmark_outline" />

                        <TextView
                            android:id="@+id/pinnedBadge"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="-6dp"
                            android:layout_marginEnd="-6dp"
                            android:background="@drawable/bg_badge_pink"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </FrameLayout>

                    <View android:layout_width="12dp" android:layout_height="1dp" />

                    <FrameLayout
                        android:id="@+id/mineBtn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_surface_round_stroke"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_user" />

                        <TextView
                            android:id="@+id/mineBadge"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="-6dp"
                            android:layout_marginEnd="-6dp"
                            android:background="@drawable/bg_badge_pink"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </FrameLayout>

                    <View android:layout_width="12dp" android:layout_height="1dp" />

                    <FrameLayout
                        android:id="@+id/shuffleBtn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_surface_round_stroke"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <ImageView
                            android:id="@+id/shuffleIcon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_shuffle" />

                        <TextView
                            android:id="@+id/shuffleBadge"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="-6dp"
                            android:layout_marginEnd="-6dp"
                            android:background="@drawable/bg_badge_pink"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- category chips -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/categoryRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- top impact slider - without image -->
            <LinearLayout
                android:id="@+id/textSliderContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="0dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="20dp"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_star_filled" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/top_impact_text"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/textSoft" />
                </LinearLayout>

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/textSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    android:clipToPadding="false"
                    android:clipChildren="false" />

                <LinearLayout
                    android:id="@+id/textDotsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- top impact slider - with image -->
            <LinearLayout
                android:id="@+id/imageSliderContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="20dp"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_star_filled" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/top_impact_image"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/textSoft" />
                </LinearLayout>

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/imageSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    android:clipToPadding="false"
                    android:clipChildren="false" />

                <LinearLayout
                    android:id="@+id/imageDotsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- 2-column grid, built manually to avoid nested-scroll RecyclerView issues -->
            <LinearLayout
                android:id="@+id/gridContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:baselineAligned="false">

                <LinearLayout
                    android:id="@+id/gridColumnRight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical" />

                <View android:layout_width="12dp" android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/gridColumnLeft"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>



    <com.google.android.material.button.MaterialButton
        android:id="@+id/fabCompose"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        app:backgroundTint="@color/white"
        app:cornerRadius="28dp"
        android:text="@string/fab_share"
        android:textAllCaps="false"
        android:textColor="#2196F3"
        android:textStyle="bold"
        android:textSize="14sp"
        app:icon="@drawable/ic_plus"
        app:iconTint="#2196F3"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        android:elevation="8dp"
        android:stateListAnimator="@null"
        android:paddingStart="24dp"
        android:paddingEnd="24dp" />
</FrameLayout>
