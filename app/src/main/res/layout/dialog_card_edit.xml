<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="620dp"
    android:background="@drawable/bg_dialog_sheet"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_main"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/phrase_label"
            android:textColor="@color/text_main"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/phraseInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:gravity="top|start"
            android:maxLength="80"
            android:hint="@string/phrase_hint"
            android:textColorHint="@color/text_soft"
            android:textColor="@color/text_main"
            android:textSize="14sp"
            android:background="@drawable/bg_btn_ghost"
            android:padding="12dp"
            android:inputType="textMultiLine"/>

        <TextView
            android:id="@+id/charCounter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/text_soft"
            android:textSize="11sp"
            android:layout_marginTop="4dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/suggestionsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/photo_label_optional"
            android:textColor="@color/text_main"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"/>

        <GridLayout
            android:id="@+id/presetGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="2"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="9dp">

            <TextView
                android:id="@+id/btnUploadPhoto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/upload_photo"
                android:textColor="@color/text_main"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="11dp"
                android:background="@drawable/bg_btn_dashed"/>

            <TextView
                android:id="@+id/btnRemovePhoto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/no_photo"
                android:textColor="@color/text_soft"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="11dp"
                android:background="@drawable/bg_btn_ghost"
                android:visibility="gone"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/preview_label"
            android:textColor="@color/text_soft"
            android:textSize="12sp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="10dp"/>

        <com.example.graduationproject.view.CalmCardView
            android:id="@+id/previewCard"
            android:layout_width="match_parent"
            android:layout_height="168dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <TextView
                android:id="@+id/btnCancel"
                style="@style/GhostButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/cancel"/>

            <TextView
                android:id="@+id/btnSave"
                style="@style/PrimaryButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="@string/save"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
