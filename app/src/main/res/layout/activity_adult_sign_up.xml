<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:clipToPadding="false">

    <!-- Decorative clouds -->
    <TextView
        android:id="@+id/cloud_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="32dp"
        android:text="@string/activity_adult_sign_up_android_text_0_1"
        android:textSize="26sp"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/cloud_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="96dp"
        android:layout_marginStart="40dp"
        android:text="@string/activity_adult_sign_up_android_text_1"
        android:textSize="20sp"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Decorative rings (Centered behind the logo) -->
    <View
        android:id="@+id/ring_1"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:background="@drawable/bg_decorative_ring"
        android:alpha="0"
        android:scaleX="0.5"
        android:scaleY="0.5"
        app:layout_constraintBottom_toBottomOf="@id/logo_container"
        app:layout_constraintEnd_toEndOf="@id/logo_container"
        app:layout_constraintStart_toStartOf="@id/logo_container"
        app:layout_constraintTop_toTopOf="@id/logo_container" />

    <View
        android:id="@+id/ring_2"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:background="@drawable/bg_decorative_ring"
        android:alpha="0"
        android:scaleX="0.5"
        android:scaleY="0.5"
        app:layout_constraintBottom_toBottomOf="@id/logo_container"
        app:layout_constraintEnd_toEndOf="@id/logo_container"
        app:layout_constraintStart_toStartOf="@id/logo_container"
        app:layout_constraintTop_toTopOf="@id/logo_container" />

    <View
        android:id="@+id/ring_3"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/bg_decorative_ring"
        android:alpha="0"
        android:scaleX="0.5"
        android:scaleY="0.5"
        app:layout_constraintBottom_toBottomOf="@id/logo_container"
        app:layout_constraintEnd_toEndOf="@id/logo_container"
        app:layout_constraintStart_toStartOf="@id/logo_container"
        app:layout_constraintTop_toTopOf="@id/logo_container" />

    <!-- Logo -->
    <FrameLayout
        android:id="@+id/logo_container"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_circle_logo"
        android:layout_marginTop="80dp"
        android:elevation="2dp"
        android:alpha="0"
        android:scaleX="0"
        android:scaleY="0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/img_logo"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_droplet"
            android:contentDescription="@null"/>
    </FrameLayout>

    <!-- Title and Subtitle -->
    <TextView
        android:id="@+id/txt_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/welcome_title"
        android:textColor="@color/text_main"
        android:textStyle="bold"
        android:textSize="@dimen/text_h1"
        android:gravity="center"
        android:alpha="0"
        android:translationY="20dp"
        app:layout_constraintTop_toBottomOf="@id/logo_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/txt_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/welcome_subtitle"
        android:textColor="@color/text_soft"
        android:textSize="@dimen/text_body"
        android:gravity="center"
        android:alpha="0"
        android:translationY="20dp"
        app:layout_constraintTop_toBottomOf="@id/txt_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Scrollable Form -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:alpha="0"
        android:translationY="30dp"
        app:layout_constraintTop_toBottomOf="@id/txt_subtitle"
        app:layout_constraintBottom_toTopOf="@id/btn_continue">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Name (optional) -->
            <LinearLayout
                android:id="@+id/section_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/name_label"
                    android:textColor="@color/text_main"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_label"
                    android:layout_gravity="start"
                    android:textAlignment="viewStart"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:id="@+id/name_field_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_user"
                        android:contentDescription="@null"
                        android:layout_marginEnd="8dp"/>

                    <EditText
                        android:id="@+id/edit_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/name_hint"
                        android:inputType="text"
                        android:textAlignment="viewStart"
                        android:textSize="14sp"
                        android:textColor="@color/text_main"
                        android:textColorHint="@color/text_soft" />
                </LinearLayout>
            </LinearLayout>

            <!-- Age range (required) -->
            <LinearLayout
                android:id="@+id/section_age"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/age_label"
                    android:textColor="@color/text_main"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_label"
                    android:layout_gravity="start"
                    android:textAlignment="viewStart"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/age_chip_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:flexWrap="wrap"
                    app:justifyContent="flex_start"/>
            </LinearLayout>

            <!-- Gender (required) -->
            <LinearLayout
                android:id="@+id/section_gender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gender_label"
                    android:textColor="@color/text_main"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_label"
                    android:layout_gravity="start"
                    android:textAlignment="viewStart"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/card_female"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        android:background="@drawable/bg_gender_card"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/gender_female_symbol"
                            android:textSize="24sp"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/txt_female_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/gender_female"
                            android:textStyle="bold"
                            android:textSize="@dimen/text_label"
                            android:textColor="@color/text_main"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/card_male"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        android:background="@drawable/bg_gender_card"
                        android:layout_marginStart="6dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/gender_male_symbol"
                            android:textSize="24sp"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/txt_male_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/gender_male"
                            android:textStyle="bold"
                            android:textSize="@dimen/text_label"
                            android:textColor="@color/text_main"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Privacy note -->
            <LinearLayout
                android:id="@+id/section_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_note_box"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/privacy_note"
                    android:textColor="@color/sage"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_note"
                    android:gravity="center"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Continue button -->
    <Button
        android:id="@+id/btn_continue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="32dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:background="@drawable/bg_button_gradient"
        android:text="@string/continue_button"
        android:textColor="@color/text_main"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textSize="@dimen/text_button"
        android:elevation="4dp"
        android:stateListAnimator="@null"
        android:enabled="false"
        android:alpha="0"
        android:translationY="20dp"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
