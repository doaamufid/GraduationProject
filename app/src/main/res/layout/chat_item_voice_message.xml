<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Voice message bubble (always from the user) -->
    <LinearLayout
        android:id="@+id/voice_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_bubble_user"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:minWidth="150dp">

        <ImageButton
            android:id="@+id/btn_voice_play"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_voice_play_circle"
            android:src="@drawable/ic_play"
            android:padding="9dp"
            android:contentDescription="@string/chat_voice_play"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <ImageView
                android:layout_width="90dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_waves"
                android:contentDescription="@null"
                tools:ignore="ContentDescription"/>

            <TextView
                android:id="@+id/txt_voice_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/chat_item_voice_message_android_text_0"
                android:textColor="@color/white"
                android:textSize="@dimen/chat_text_meta"
                android:textStyle="bold"
                tools:text="00:05"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Meta row: time + double-check icon -->
    <LinearLayout
        android:id="@+id/row_voice_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp">

        <TextView
            android:id="@+id/txt_voice_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_soft"
            android:textSize="@dimen/chat_text_meta"
            android:layout_marginStart="4dp"
            tools:text="٩:٤٠ ص"/>

        <ImageView
            android:id="@+id/img_voice_check"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:src="@drawable/ic_check_check"
            android:layout_marginStart="4dp"
            android:contentDescription="@null"
            tools:ignore="ContentDescription"/>
    </LinearLayout>

</LinearLayout>