<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_bordered"
                android:src="@drawable/ic_arrow_right"
                android:padding="10dp"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/profile_title"
                android:textColor="@color/text_main"
                android:textStyle="bold"
                android:textSize="@dimen/text_title2"
                android:gravity="center"/>

            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_bordered"
                android:src="@drawable/ic_settings"
                android:padding="11dp"
                android:contentDescription="@null"/>
        </LinearLayout>

        <!-- Avatar + name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/txt_avatar_initial"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_avatar_gradient"
                android:gravity="center"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="34sp"
                android:layout_marginBottom="12dp"
                tools:text="س"/>

            <TextView
                android:id="@+id/txt_profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_main"
                android:textStyle="bold"
                android:textSize="@dimen/text_h1"
                android:layout_marginBottom="4dp"
                tools:text="سارة"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/member_since"
                android:textColor="@color/text_soft"
                android:textSize="@dimen/text_body"/>
        </LinearLayout>

        <!-- Privacy note -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_privacy_note"
            android:padding="12dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/privacy_note"
                android:textColor="@color/sage"
                android:textStyle="bold"
                android:textSize="@dimen/text_body"
                android:gravity="center"
                android:layout_marginEnd="6dp"/>

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_lock"
                app:tint="@color/sage"
                android:contentDescription="@null"/>
        </LinearLayout>

        <!-- Reports & Stats entry card -->
        <LinearLayout
            android:id="@+id/btn_reports_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_button_gradient"
            android:padding="16dp"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="start">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="التقارير والإحصائيات"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_title"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مزاجك، أرشيفك، وتقارير أطفالك"
                    android:textColor="@color/white"
                    android:alpha="0.8"
                    android:textSize="@dimen/text_tiny"/>
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/white"
                android:contentDescription="@null"/>
        </LinearLayout>

        <!-- Achievements -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/achievements_title_profile"
                android:textColor="@color/text_main"
                android:textStyle="bold"
                android:textSize="@dimen/text_title"
                android:gravity="start"/>

            <TextView
                android:id="@+id/txt_badges_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_soft"
                android:textStyle="bold"
                android:textSize="@dimen/text_body"
                tools:text="٤/٦"/>
        </LinearLayout>

        <GridLayout
            android:id="@+id/badges_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
