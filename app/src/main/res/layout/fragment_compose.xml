<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@color/bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="32dp">

            <!-- top bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:id="@+id/backBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_surface_round_stroke">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_back" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="@string/compose_title"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/text" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/compose_hint_top"
                android:textSize="12sp"
                android:textColor="@color/textSoft"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/messageInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="5"
                android:gravity="top|right"
                android:background="@drawable/bg_edittext"
                android:padding="14dp"
                android:hint="@string/compose_placeholder"
                android:textSize="13sp"
                android:textColorHint="@color/textSoft"
                android:inputType="textMultiLine"
                android:layout_marginBottom="16dp" />

            <!-- Foldable Category Picker -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_edittext"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:id="@+id/categoryToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <ImageView
                        android:id="@+id/categoryChevron"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_down" />

                    <TextView
                        android:id="@+id/categorySelectedIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_whitecc_circle"
                        android:gravity="center"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/compose_category_label"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/categoryFold"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:clipChildren="true">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/categoryRecyclerCompose"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="10dp"
                        android:paddingBottom="14dp"
                        android:orientation="horizontal"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                </FrameLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/imagePreviewWrap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imagePreview"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_edittext" />

                <FrameLayout
                    android:id="@+id/removeImageBtn"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_whitecc_circle">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_close" />
                </FrameLayout>
            </FrameLayout>

            <!-- foldable emoji picker -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_edittext"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:id="@+id/emojiToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <ImageView
                        android:id="@+id/emojiChevron"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_down" />

                    <TextView
                        android:id="@+id/emojiSelectedIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:textSize="15sp"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/emojiSmileIcon"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginStart="10dp"
                        android:src="@drawable/ic_smile" />

                    <TextView
                        android:id="@+id/emojiToggleLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/compose_emoji_add"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/emojiFold"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:clipChildren="true">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/emojiRecycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="10dp"
                        android:paddingBottom="14dp"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="6" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/choose_card_color"
                android:textStyle="bold"
                android:textSize="11sp"
                android:textColor="@color/text"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/colorPickerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp"
                android:gravity="center_vertical" />

            <LinearLayout
                android:id="@+id/addImageBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="20dp"
                android:background="@drawable/bg_dashed_alt"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_camera" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/compose_add_image"
                    android:textSize="11sp"
                    android:textColor="@color/textSoft" />
            </LinearLayout>

            <Button
                android:id="@+id/submitBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="15dp"
                android:background="@drawable/bg_pill_primary"
                android:text="@string/compose_submit"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="13sp"
                android:drawableStart="@drawable/ic_send"
                android:drawablePadding="8dp"
                android:stateListAnimator="@null"
                android:enabled="false"
                android:alpha="0.4" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
