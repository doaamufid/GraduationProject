<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minHeight="420dp"
            android:padding="18dp">

            <!-- LOCKED (no active card) -->
            <LinearLayout
                android:id="@+id/lockedContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒"
                    android:textSize="34sp"
                    android:alpha="0.6"
                    android:layout_marginBottom="14dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/locked_msg"
                    android:textColor="@color/muted"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.5"
                    android:layout_marginBottom="22dp"
                    android:maxWidth="260dp"/>

                <TextView
                    android:id="@+id/btnGoToGallery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/go_to_gallery"
                    android:textColor="@color/cardBtnText"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:paddingStart="26dp"
                    android:paddingEnd="26dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:background="@drawable/bg_btn_primary"/>
            </LinearLayout>

            <!-- INTRO (simStep < 0) -->
            <LinearLayout
                android:id="@+id/introContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/sim_intro_msg"
                    android:textColor="@color/muted"
                    android:textSize="13.5sp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.5"
                    android:layout_marginBottom="30dp"
                    android:maxWidth="270dp"/>

                <FrameLayout
                    android:id="@+id/btnStartSim"
                    android:layout_width="128dp"
                    android:layout_height="128dp"
                    android:background="@drawable/bg_start_circle">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🫶"
                            android:textSize="26sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sim_start_btn"
                            android:textColor="@color/cardBtnText"
                            android:textStyle="bold"
                            android:textSize="12.5sp"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/sim_start_label"
                    android:textColor="@color/cream"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="22dp"/>

                <TextView
                    android:id="@+id/btnGoDhikrHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/no_favorite_dhikr_prompt"
                    android:textColor="@color/amber"
                    android:textSize="11.5sp"
                    android:layout_marginTop="10dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- STEP FLOW (simStep 0..3) -->
            <LinearLayout
                android:id="@+id/stepContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btnCancelSim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cancel_x"
                    android:textColor="@color/mutedDim"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp"
                    android:padding="4dp"/>

                <com.example.graduationproject.view.StepDotsView
                    android:id="@+id/stepDots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="22dp"/>

                <!-- BREATHING -->
                <LinearLayout
                    android:id="@+id/breathingContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/breathing_technique_label"
                        android:textColor="@color/mutedDim"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/breathCycleLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/amber"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="18dp"/>

                    <FrameLayout
                        android:layout_width="150dp"
                        android:layout_height="150dp">

                        <View
                            android:id="@+id/breathCircle"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_breath_circle"/>

                        <TextView
                            android:id="@+id/breathSecsText"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:textColor="@color/cream"
                            android:textSize="15sp"/>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/breathPhaseLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cream"
                        android:textSize="15.5sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginTop="26dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/breathing_footer"
                        android:textColor="@color/mutedDim"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_marginTop="10dp"
                        android:maxWidth="230dp"/>
                </LinearLayout>

                <!-- GROUNDING -->
                <LinearLayout
                    android:id="@+id/groundingContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="60dp"
                    android:paddingBottom="60dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🖐️"
                        android:textSize="30sp"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/grounding_msg"
                        android:textColor="@color/cream"
                        android:textSize="15.5sp"
                        android:gravity="center"
                        android:maxWidth="250dp"/>
                </LinearLayout>

                <!-- DHIKR -->
                <LinearLayout
                    android:id="@+id/dhikrContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/dhikrEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="28sp"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:id="@+id/dhikrPickText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cream"
                        android:textSize="17sp"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.8"
                        android:maxWidth="260dp"
                        android:layout_marginBottom="22dp"/>

                    <com.example.graduationproject.view.CircularCountdownView
                        android:id="@+id/dhikrCountdownRing"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:id="@+id/dhikrSourceLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/mutedDim"
                        android:textSize="11sp"/>

                    <TextView
                        android:id="@+id/btnAnotherDhikr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/another_dhikr"
                        android:textColor="@color/amber"
                        android:textSize="11.5sp"
                        android:background="@drawable/bg_chip_plain"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:layout_marginTop="16dp"
                        android:visibility="gone"/>
                </LinearLayout>

                <!-- CARD REVEAL -->
                <LinearLayout
                    android:id="@+id/cardRevealContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/cardAutoBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/card_auto_badge"
                        android:textColor="@color/amber"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_badge_pill"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:layout_marginBottom="12dp"/>

                    <com.example.graduationproject.view.CalmCardView
                        android:id="@+id/revealCalmCard"
                        android:layout_width="match_parent"
                        android:layout_height="320dp"/>

                    <TextView
                        android:id="@+id/btnImOk"
                        style="@style/PrimaryButton"
                        android:layout_marginTop="18dp"
                        android:text="@string/im_ok_now"/>
                </LinearLayout>

            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</FrameLayout>
