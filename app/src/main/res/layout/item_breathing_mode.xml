<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardModeRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="6dp"
    app:cardMaxElevation="8dp"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutInner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:layoutDirection="locale">

        <!-- Trailing Illustration (Left side in RTL) -->
        <ImageView
            android:id="@+id/ivIllustration"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/air" />

        <!-- Text Content (Leading side in RTL) -->
        <TextView
            android:id="@+id/tvModeName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:textColor="#1F3A60"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="start"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivIllustration"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Equal Breathing" />

        <TextView
            android:id="@+id/tvModeDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#5C7290"
            android:textSize="13sp"
            android:gravity="start"
            app:layout_constraintEnd_toEndOf="@id/tvModeName"
            app:layout_constraintStart_toStartOf="@id/tvModeName"
            app:layout_constraintTop_toBottomOf="@id/tvModeName"
            tools:text="Balanced breathing helps you relax and concentrate." />

        <!-- Pattern Text -->
        <TextView
            android:id="@+id/tvPattern"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="12dp"
            android:textColor="#5C7290"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/btnStartMode"
            app:layout_constraintEnd_toStartOf="@+id/btnStartMode"
            app:layout_constraintTop_toTopOf="@+id/btnStartMode"
            tools:text="4-0-4-0" />

        <!-- Start Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartMode"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#4A5AFF"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="20dp"
            android:text="@string/item_breathing_mode_android_text_0"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="20dp"
            app:layout_constraintEnd_toEndOf="@id/tvModeName"
            app:layout_constraintTop_toBottomOf="@id/tvModeDesc" />

        <!-- Minutes Row (Under Button) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="@+id/btnStartMode"
            app:layout_constraintTop_toBottomOf="@id/btnStartMode">

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#5C7290"
                android:textSize="12sp"
                android:alpha="0.8"
                tools:text="٣ دقائق" />

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="4dp"
                android:alpha="0.6"
                android:src="@drawable/ic_clock"
                app:tint="#5C7290" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
