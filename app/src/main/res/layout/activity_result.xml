<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_cream" android:fillViewport="true" android:layoutDirection="rtl">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="36dp" android:paddingBottom="24dp">
        <ImageView android:layout_width="84dp" android:layout_height="84dp" android:src="@drawable/ic_bear_face"/>
        <androidx.cardview.widget.CardView android:layout_width="92dp" android:layout_height="92dp" android:layout_marginTop="12dp" app:cardCornerRadius="16dp" app:cardElevation="1dp">
            <ImageView android:id="@+id/imgDrawingSmall" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/orange_light" android:scaleType="centerCrop"/>
        </androidx.cardview.widget.CardView>
        <!--  message bubble  -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/bg_card_white" android:elevation="1dp" android:gravity="center" android:orientation="vertical" android:padding="22dp">
            <TextView android:id="@+id/tvFeedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/result_message" android:textColor="@color/text_dark" android:textSize="16sp" android:lineSpacingExtra="4dp"/>
            <FrameLayout android:id="@+id/btnPlayAudio" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginTop="16dp" android:background="@drawable/bg_play_circle">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_play"/>
            </FrameLayout>
        </LinearLayout>
        <!--  star pill  -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_star_pill" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="10dp" android:paddingBottom="10dp">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_star"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/got_star" android:textColor="#B8860B" android:textSize="14sp" android:textStyle="bold"/>
        </LinearLayout>
        <!--  tell family note  -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/tell_family"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnDrawMore"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_button_outline"
            android:elevation="0dp"
            android:text="@string/btn_draw_more"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp" />
        <Button android:id="@+id/btnFinish" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/bg_button_orange" android:elevation="0dp" android:text="@string/btn_finish_result" android:textAllCaps="false" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold"/>
    </LinearLayout>
</ScrollView>