<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/adult_chat_bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/adult_chat_bg_video_thumb">
        <View android:id="@+id/ring1" android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:background="@drawable/adult_chat_ring_stroke_light"/>
        <View android:id="@+id/ring2" android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:background="@drawable/adult_chat_ring_stroke_light"/>
        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center"
            android:background="@drawable/adult_chat_bg_video_play_dot" android:padding="7dp" android:src="@drawable/adult_chat_ic_play"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/txtTag" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/adult_chat_purple_mid" android:textSize="10sp" android:textStyle="bold" android:text="فيديو مهدّئ"/>
        <TextView android:id="@+id/txtTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/adult_chat_text_dark" android:textSize="13.5sp" android:textStyle="bold" android:text="٣ دقائق لتهدئة عقلك"/>
        <TextView android:id="@+id/txtDuration" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/adult_chat_text_faint" android:textSize="11sp" android:text="٣:١٠"/>
    </LinearLayout>
</LinearLayout>
