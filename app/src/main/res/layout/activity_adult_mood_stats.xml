<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:fillViewport="true"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="32dp">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_bordered"
                android:src="@drawable/ic_arrow_right"
                android:padding="10dp"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="التقارير والإحصائيات"
                android:textColor="@color/text_main"
                android:textStyle="bold"
                android:textSize="@dimen/text_title2"
                android:gravity="center"/>

            <View android:layout_width="40dp" android:layout_height="40dp"/>
        </LinearLayout>

        <!-- Mood Stats Card -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="إحصائيات المزاج"
            android:textColor="@color/text_main"
            android:textStyle="bold"
            android:textSize="@dimen/text_title"
            android:layout_gravity="start"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="بيانات آخر ٣٠ يوم فقط — كل شهر يبدأ سجل جديد"
            android:textColor="@color/text_soft"
            android:textSize="@dimen/text_small"
            android:layout_gravity="start"
            android:layout_marginBottom="12dp"/>

        <!-- Segmented Tab Control -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_segmented_track"
            android:padding="4dp">

            <View
                android:id="@+id/segment_indicator"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_segmented_indicator" />

            <LinearLayout
                android:id="@+id/segment_buttons"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tab_day"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/adult_stats_tab_day"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#8598AC" />

                <TextView
                    android:id="@+id/tab_week"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/adult_stats_tab_week"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <TextView
                    android:id="@+id/tab_month"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/adult_stats_tab_month"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#8598AC" />
            </LinearLayout>
        </FrameLayout>

        <!-- Interactive Chart Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_readout_icon">

                    <com.example.graduationproject.widget.AdultFaceView
                        android:id="@+id/scrub_face"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center" />
                </FrameLayout>

                <TextView
                    android:id="@+id/scrub_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="مرتاح"/>

                <TextView
                    android:id="@+id/scrub_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textSize="12sp"
                    android:textColor="#8598AC"
                    tools:text="· اليوم"/>
            </LinearLayout>

            <com.example.graduationproject.widget.AdultChartView
                android:id="@+id/chart_view"
                android:layout_width="match_parent"
                android:layout_height="160dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="حرّك إصبعك على الخط لتشوف مزاجك بأي لحظة"
                android:textSize="10sp"
                android:textColor="#B7C2CE" />
        </LinearLayout>

        <!-- Activity Stats Grid -->
        <LinearLayout
            android:id="@+id/stats_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp"/>

        <!-- Personal Archive Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/archive_title"
            android:textColor="@color/text_main"
            android:textStyle="bold"
            android:textSize="@dimen/text_title"
            android:layout_gravity="start"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:id="@+id/archive_links_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp"/>

        <!-- Children's Reports Card -->
        <LinearLayout
            android:id="@+id/btn_children_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_children_link"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_white_22">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_users"
                    app:tint="@color/white"
                    android:contentDescription="@null"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical"
                android:gravity="start">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="تقارير أطفالك"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_title"/>

                <TextView
                    android:id="@+id/txt_children_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/children_count_label"
                    android:textColor="@color/white"
                    android:alpha="0.7"
                    android:textSize="@dimen/text_tiny"/>
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_left"
                app:tint="#AAFFFFFF"
                android:contentDescription="@null"/>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
