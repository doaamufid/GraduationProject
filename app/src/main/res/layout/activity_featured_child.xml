<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9EF">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="رجوع" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="الطفل المميز 🏆"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#5A4632" />

        <!-- مساحة فاضية عشان العنوان يضل بالنص فعليًا (متوازن مع زر الرجوع) -->
        <View
            android:layout_width="36dp"
            android:layout_height="36dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <!-- كارت الطفل المميز -->
            <LinearLayout
                android:id="@+id/featuredCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card_orange"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👑"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/tvFeaturedAvatar"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_bubble_yellow"
                    android:gravity="center"
                    android:textSize="42sp"
                    tools:text="🦁" />

                <TextView
                    android:id="@+id/tvFeaturedName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#5A4632"
                    tools:text="ليان" />

                <TextView
                    android:id="@+id/tvFeaturedStarsVisual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="22sp"
                    android:letterSpacing="0.1"
                    tools:text="⭐⭐⭐⭐⭐" />

                <TextView
                    android:id="@+id/tvFeaturedStarsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="14sp"
                    android:textColor="#8A7256"
                    tools:text="24 نجمة" />

            </LinearLayout>

            <!-- حالة القائمة الفاضية (ولا طفل عنده نجوم لسا) -->
            <TextView
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:text="لسا محدا كسب نجوم! ابدؤوا نشاط جديد 🌟"
                android:textSize="15sp"
                android:textColor="#8A7256"
                android:visibility="gone" />

            <!-- باقي الأطفال -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRestOfChildren"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:visibility="gone"
                tools:listitem="@layout/item_featured_child" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>