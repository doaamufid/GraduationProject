<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="32dp"
    android:background="@color/bg">

    <FrameLayout
        android:id="@+id/pulseCircle"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_analyzing_circle"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_sparkles" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/analyzing_title"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="@color/text"
        android:gravity="center"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/analyzing_sub"
        android:textSize="11sp"
        android:textColor="@color/textSoft"
        android:gravity="center" />

</LinearLayout>
