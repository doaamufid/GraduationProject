<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginHorizontal="6dp"
    android:gravity="center"
    android:paddingTop="4dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/tvCategoryEmoji"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:background="@drawable/bg_category_emoji_selector"
        android:text="@string/item_category_chip_android_text_0"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvCategoryName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/item_category_chip_android_text_1"
        android:textColor="#2D587B"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>