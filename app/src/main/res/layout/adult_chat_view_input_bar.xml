<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/inputWrapRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <!-- reply-to / editing context bar -->
    <LinearLayout
        android:id="@+id/contextBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/adult_chat_bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtContextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/adult_chat_purple_mid"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtContextSnippet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/adult_chat_text_soft"
                android:textSize="11.5sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnContextClose"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/adult_chat_bg_emoji_toggle"
            android:padding="5dp"
            android:src="@drawable/adult_chat_ic_close" />
    </LinearLayout>

    <!-- emoji picker -->
    <GridLayout
        android:id="@+id/emojiGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/adult_chat_bg_popup"
        android:columnCount="8"
        android:padding="8dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone" ></GridLayout>

    <!-- actual input pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/adult_chat_bg_input_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="7dp">

        <FrameLayout
            android:id="@+id/btnMicSend"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/adult_chat_bg_mic_send_btn">

            <ImageView
                android:id="@+id/iconMic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/adult_chat_ic_mic" />

            <ImageView
                android:id="@+id/iconSend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/adult_chat_ic_send"
                android:visibility="gone" />
        </FrameLayout>

        <EditText
            android:id="@+id/editInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:gravity="end|center_vertical"
            android:hint="اكتب هنا.."
            android:imeOptions="actionSend"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/adult_chat_text_mid"
            android:textColorHint="@color/adult_chat_text_placeholder"
            android:textSize="13.5sp" />

        <ImageButton
            android:id="@+id/btnEmojiToggle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/adult_chat_bg_emoji_toggle"
            android:padding="7dp"
            android:src="@drawable/adult_chat_ic_smile" />
    </LinearLayout>
</LinearLayout>
