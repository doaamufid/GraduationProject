<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="620dp"
    android:background="@drawable/kids_calm_bg_dialog_sheet"
    android:padding="20dp"
    android:clipChildren="false"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false">

        <TextView
            android:id="@+id/dialogCardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:textColor="@color/kids_calm_navy"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp"
            style="@style/kids_calm_Font.Display" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:text="@string/kids_calm_dialog_phrase_label"
            android:textColor="@color/kids_calm_navy"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            style="@style/kids_calm_Font.Display" />

        <EditText
            android:id="@+id/phraseInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:gravity="top|start"
            android:maxLength="60"
            android:background="@drawable/kids_calm_bg_pill_outline"
            android:padding="12dp"
            android:hint="@string/kids_calm_dialog_phrase_hint"
            android:textColor="@color/kids_calm_navy"
            android:textColorHint="@color/kids_calm_navySoft"
            android:textSize="14sp"
            style="@style/kids_calm_Font.Body" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/quickPhrasesRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:text="@string/kids_calm_dialog_sticker_label"
            android:textColor="@color/kids_calm_navy"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            style="@style/kids_calm_Font.Display" />

        <GridLayout
            android:id="@+id/stickerGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3" />

        <TextView
            android:id="@+id/photoButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:background="@drawable/kids_calm_bg_dashed_empty"
            android:gravity="center"
            android:padding="11dp"
            android:text="@string/kids_calm_dialog_photo_btn"
            android:textColor="@color/kids_calm_navySoft"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            style="@style/kids_calm_Font.Body" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/kids_calm_dialog_preview_label"
            android:textColor="@color/kids_calm_navySoft"
            android:textSize="12sp"
            style="@style/kids_calm_Font.Body" />

        <com.example.graduationproject.view.kidsCalmKidCardView
            android:id="@+id/previewKidCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="18dp">

            <TextView
                android:id="@+id/cancelButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/kids_calm_bg_ghost_button"
                android:gravity="center"
                android:paddingVertical="13dp"
                android:text="@string/kids_calm_dialog_cancel"
                android:textColor="@color/kids_calm_navy"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                style="@style/kids_calm_Font.Display" />

            <TextView
                android:id="@+id/saveCardButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/kids_calm_bg_big_button_disabled"
                android:gravity="center"
                android:paddingVertical="13dp"
                android:text="@string/kids_calm_dialog_save_card"
                android:textColor="@color/kids_calm_navySoft"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                style="@style/kids_calm_Font.Display" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
