<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <include layout="@layout/view_step_progress" />

        <!-- Original thought, dimmed -->
        <LinearLayout
            android:id="@+id/cardOriginal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:alpha="0.5"
            android:background="@drawable/bg_card_translucent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/original_label"
                style="@style/Text.Soft"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvOriginalThought"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="&quot;الفكرة الأصلية&quot;" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="@string/mirror_label"
            style="@style/Text.Soft"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Mirror reframe card (white bg) - text swapped with mirror-fade animation -->
        <FrameLayout
            android:id="@+id/cardMirror"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_mirror_white"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvMirrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.3"
                android:textColor="@color/grad_top"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="إعادة صياغة الفكرة" />
        </FrameLayout>

        <!-- Carousel dot indicators -->
        <LinearLayout
            android:id="@+id/dotsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <!-- Exercise card -->
        <LinearLayout
            android:id="@+id/cardExercise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_card_soft_05_border"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:gravity="end"
                android:text="@string/exercise_label"
                android:textColor="@color/primary_light"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvExercise"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                tools:text="تمرين اليوم" />
        </LinearLayout>

        <!-- Reword / Save row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReword"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                app:backgroundTint="@color/white"
                app:cornerRadius="30dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp"
                android:text="@string/reword_button"
                android:textColor="@color/text_soft"
                android:textStyle="bold"
                android:textSize="13sp"
                app:icon="@drawable/ic_refresh"
                app:iconGravity="textStart"
                app:iconTint="@color/text_soft"
                app:iconPadding="6dp"
                android:textAllCaps="false"
                android:elevation="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1.4"
                app:backgroundTint="@color/primary"
                app:cornerRadius="30dp"
                android:text="@string/save_button"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="13sp"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart"
                app:iconTint="@color/white"
                app:iconPadding="6dp"
                android:textAllCaps="false"
                android:elevation="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnBackToChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/back_to_chat"
            style="@style/Text.Soft"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
