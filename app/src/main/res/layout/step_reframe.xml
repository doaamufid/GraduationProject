<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <!-- Mirror Reframe Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMirror"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:text="نظرة أخرى"
                    android:textColor="#8A9CB2"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMirrorText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#1F3A60"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:lineSpacingMultiplier="1.3"
                    tools:text="ربما اليوم كان صعباً وأحسست بالوحدة - هذا الشعور حقيقي." />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Carousel dot indicators -->
        <LinearLayout
            android:id="@+id/dotsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <!-- Exercise Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardExercise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:cardBackgroundColor="#F0F0F9"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:layout_gravity="end"
                    android:text="🏋️ تمرين اليوم"
                    android:textColor="#7E81BA"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvExercise"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="#1F3A60"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.4"
                    tools:text="اكتبي ٣ أشياء إيجابية صارت اليوم، مهما كانت صغيرة" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Action Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReword"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="28dp"
                app:strokeColor="#E0E0EF"
                app:strokeWidth="1dp"
                android:text="صياغة أخرى"
                android:textColor="#7E81BA"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1.3"
                app:backgroundTint="#7E81BA"
                app:cornerRadius="28dp"
                android:text="حفظ الفكرة"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textAllCaps="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnBackToChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="الرجوع للمحادثة"
            android:textColor="#8A9CB2"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
