<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/kids_calm_bg_list_item_idle"
    android:padding="11dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/wordEmoji"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/kids_calm_bg_emoji_option"
            android:gravity="center"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="11dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wordText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="viewStart"
                android:textColor="@color/kids_calm_navy"
                android:textSize="13.5sp"
                android:textStyle="bold"
                style="@style/kids_calm_Font.Display" />

            <TextView
                android:id="@+id/wordDurLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAlignment="viewStart"
                android:textColor="@color/kids_calm_navySoft"
                android:textSize="10.5sp"
                android:visibility="gone"
                style="@style/kids_calm_Font.Body" />
        </LinearLayout>

        <TextView
            android:id="@+id/favoriteHeart"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="@string/kids_calm_heart_empty"
            android:textSize="19sp"
            android:textColor="#C7D3E4"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/durChipsWrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="9dp"
            android:background="#F1F5FB" />

        <LinearLayout
            android:id="@+id/durChipsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </LinearLayout>

</LinearLayout>
