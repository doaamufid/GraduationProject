<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Message bubble -->
    <TextView
        android:id="@+id/txt_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:maxWidth="@dimen/chat_bubble_max_width"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textSize="@dimen/chat_text_body"
        android:lineSpacingMultiplier="1.3"
        tools:text="@string/chat_node_start_bot"
        tools:background="@drawable/bg_bubble_bot"
        tools:textColor="@color/text_main"/>

    <!-- Meta row: time + (user-only) double-check icon -->
    <LinearLayout
        android:id="@+id/row_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp">

        <TextView
            android:id="@+id/txt_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_soft"
            android:textSize="@dimen/chat_text_meta"
            android:layout_marginStart="4dp"
            tools:text="@string/chat_now"/>

        <ImageView
            android:id="@+id/img_check"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:src="@drawable/ic_check_check"
            android:visibility="gone"
            android:contentDescription="@null"
            tools:visibility="visible"/>
    </LinearLayout>

    <!-- Optional inline suggestion card (breathing / dhikr / article) -->
    <FrameLayout
        android:id="@+id/card_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        tools:visibility="visible"/>

</LinearLayout>
