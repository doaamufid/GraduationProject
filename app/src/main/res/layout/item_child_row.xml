<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_bordered"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <ImageButton
        android:id="@+id/btn_edit_child"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_card_flat"
        android:src="@drawable/ic_pencil"
        android:padding="9dp"
        android:contentDescription="@null"/>

    <LinearLayout
        android:id="@+id/btn_open_child"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical"
        android:gravity="start"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/txt_child_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_main"
            android:textStyle="bold"
            android:textSize="@dimen/text_body3"
            tools:text="يوسف"/>

        <TextView
            android:id="@+id/txt_child_age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_soft"
            android:textSize="@dimen/text_small"
            tools:text="١٠ سنوات · اضغط لعرض إحصائياته"/>
    </LinearLayout>

    <TextView
        android:id="@+id/txt_child_avatar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:layout_marginStart="10dp"
        tools:text="🧒"/>

    <ImageButton
        android:id="@+id/btn_delete_child"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_circle_delete_light"
        android:src="@drawable/ic_trash"
        android:padding="8dp"
        android:layout_marginStart="10dp"
        android:contentDescription="@null"/>
</LinearLayout>
