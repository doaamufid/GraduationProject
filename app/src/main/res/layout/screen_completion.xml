<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="✨"
        android:textSize="56sp" />

    <TextView
        android:id="@+id/tvDoneTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="فكرة جديدة!"
        android:textColor="#1F3A60"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDoneSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"
        android:text="رائع، لقد نجحتِ في موازنة فكرتك.\nتذكري دائماً أن المشاعر عابرة."
        android:textColor="#8A9CB2"
        android:textSize="16sp" />

    <!-- Exercise Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDoneExercise"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        app:cardBackgroundColor="#F0F0F9"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:layout_gravity="end"
                android:text="🏋️ تمرينك لليوم"
                android:textColor="#7E81BA"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCompletionExercise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="#1F3A60"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.4"
                tools:text="اكتبي ٣ أشياء إيجابية صارت اليوم، مهما كانت صغيرة" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAnotherThought"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:backgroundTint="#7E81BA"
        app:cornerRadius="30dp"
        android:text="موازنة فكرة أخرى"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textAllCaps="false"
        android:elevation="4dp" />

</LinearLayout>
