<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/adult_chat_bg_card_sos"
    android:orientation="horizontal"
    android:padding="14dp">

    <FrameLayout
        android:layout_width="46dp"
        android:layout_height="46dp">
        <View android:id="@+id/sosPulse" android:layout_width="46dp" android:layout_height="46dp" android:layout_gravity="center"
            android:background="@drawable/adult_chat_ring_stroke_light" android:alpha="0.6"/>
        <ImageView android:layout_width="46dp" android:layout_height="46dp" android:layout_gravity="center"
            android:background="@drawable/adult_chat_bg_icon_circle_sos" android:padding="12dp" android:src="@drawable/adult_chat_ic_shield"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/adult_chat_text_dark" android:textSize="14sp" android:textStyle="bold"
            android:text="تهدئة فورية بضغطة واحدة"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:layout_marginBottom="4dp" android:lineSpacingMultiplier="1.5"
            android:textColor="@color/adult_chat_text_soft" android:textSize="12sp"
            android:text="إذا كان الأمر صعباً الآن، دعني آخذك مباشرة إلى تمرين تنفّس موجّه."/>

        <TextView android:id="@+id/btnCta" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/adult_chat_bg_cta_sos" android:gravity="center" android:padding="11dp"
            android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"
            android:text="ابدأ الآن — One Click Calm"/>
    </LinearLayout>
</LinearLayout>
