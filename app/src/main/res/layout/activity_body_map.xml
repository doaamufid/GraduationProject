<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAFC"
    android:layoutDirection="rtl"
    tools:context=".BodyMapActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/activity_body_map_android_contentdescription_0_1"
            android:src="@drawable/outline_arrow_forward_24"
            android:padding="8dp"
            app:tint="@color/text_main"
            android:background="@drawable/bg_icon_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/btnNotSure"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_pill_accent_round"
            android:backgroundTint="#E1F1FF"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/activity_body_map_android_text_1_1"
            android:textColor="#3A6898"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/activity_body_map_android_text_2_1"
            android:textColor="#3A6898"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnBack"
            app:layout_constraintStart_toEndOf="@id/btnNotSure"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvGuideText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/activity_body_map_android_text_3_1"
                android:textColor="#7F8C8D"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="24dp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutBodyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp">

                <!-- مجسم الجسد -->
                <ImageView
                    android:id="@+id/imgBody"
                    android:layout_width="100dp"
                    android:layout_height="320dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/body"
                    android:clickable="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.20"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- نقرة الرأس والرقبة -->
                <View
                    android:id="@+id/dotHead"
                    android:layout_width="45dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintBottom_toBottomOf="@id/imgBody"
                    app:layout_constraintEnd_toEndOf="@id/imgBody"
                    app:layout_constraintStart_toStartOf="@id/imgBody"
                    app:layout_constraintTop_toTopOf="@id/imgBody"
                    app:layout_constraintVertical_bias="0.06" />

                <!-- نقرة الأكتاف -->
                <View
                    android:id="@+id/dotShoulders"
                    android:layout_width="85dp"
                    android:layout_height="28dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintBottom_toBottomOf="@id/imgBody"
                    app:layout_constraintEnd_toEndOf="@id/imgBody"
                    app:layout_constraintStart_toStartOf="@id/imgBody"
                    app:layout_constraintTop_toTopOf="@id/imgBody"
                    app:layout_constraintVertical_bias="0.24" />

                <!-- نقرة الصدر -->
                <View
                    android:id="@+id/dotChest"
                    android:layout_width="55dp"
                    android:layout_height="35dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintBottom_toBottomOf="@id/imgBody"
                    app:layout_constraintEnd_toEndOf="@id/imgBody"
                    app:layout_constraintStart_toStartOf="@id/imgBody"
                    app:layout_constraintTop_toTopOf="@id/imgBody"
                    app:layout_constraintVertical_bias="0.44" />

                <!-- نقرة المعدة -->
                <View
                    android:id="@+id/dotStomach"
                    android:layout_width="55dp"
                    android:layout_height="35dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintBottom_toBottomOf="@id/imgBody"
                    app:layout_constraintEnd_toEndOf="@id/imgBody"
                    app:layout_constraintStart_toStartOf="@id/imgBody"
                    app:layout_constraintTop_toTopOf="@id/imgBody"
                    app:layout_constraintVertical_bias="0.66" />

                <!-- بطاقة الرأس والرقبة -->
                <LinearLayout
                    android:id="@+id/cardLeftHead"
                    android:layout_width="105dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_suggestion_btn"
                    android:backgroundTint="#FFF9E7"
                    android:padding="6dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/dotHead"
                    app:layout_constraintBottom_toBottomOf="@id/dotHead">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_body_map_android_text_4_1"
                        android:textColor="#B7950B"
                        android:textStyle="bold"
                        android:textSize="13sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_body_map_android_text_5_1"
                        android:textColor="#7F8C8D"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <!-- بطاقة الأكتاف -->
                <LinearLayout
                    android:id="@+id/cardLeftShoulders"
                    android:layout_width="105dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_suggestion_btn"
                    android:backgroundTint="#EBF5FB"
                    android:padding="6dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/dotShoulders"
                    app:layout_constraintBottom_toBottomOf="@id/dotShoulders">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_body_map_android_text_6_1"
                        android:textColor="#2980B9"
                        android:textStyle="bold"
                        android:textSize="13sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_body_map_android_text_7_1"
                        android:textColor="#7F8C8D"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <!-- بطاقة الصدر -->
                <LinearLayout
                    android:id="@+id/cardLeftChest"
                    android:layout_width="105dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_suggestion_btn"
                    android:backgroundTint="#FDEDEC"
                    android:padding="6dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/dotChest"
                    app:layout_constraintBottom_toBottomOf="@id/dotChest">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_body_map_android_text_8_1"
                        android:textColor="#CB4335"
                        android:textStyle="bold"
                        android:textSize="13sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_body_map_android_text_9_1"
                        android:textColor="#7F8C8D"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <!-- بطاقة المعدة -->
                <LinearLayout
                    android:id="@+id/cardLeftStomach"
                    android:layout_width="105dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_suggestion_btn"
                    android:backgroundTint="#EAECEE"
                    android:padding="6dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/dotStomach"
                    app:layout_constraintBottom_toBottomOf="@id/dotStomach">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_body_map_android_text_10_1"
                        android:textColor="#5D6D7E"
                        android:textStyle="bold"
                        android:textSize="13sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_body_map_android_text_11_1"
                        android:textColor="#7F8C8D"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <!-- خطوط متقطعة -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layerType="software"
                    android:background="@drawable/dashed_line"
                    app:layout_constraintBottom_toBottomOf="@id/dotHead"
                    app:layout_constraintEnd_toStartOf="@id/cardLeftHead"
                    app:layout_constraintStart_toEndOf="@id/dotHead"
                    app:layout_constraintTop_toTopOf="@id/dotHead" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layerType="software"
                    android:background="@drawable/dashed_line"
                    app:layout_constraintBottom_toBottomOf="@id/dotShoulders"
                    app:layout_constraintEnd_toStartOf="@id/cardLeftShoulders"
                    app:layout_constraintStart_toEndOf="@id/dotShoulders"
                    app:layout_constraintTop_toTopOf="@id/dotShoulders" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layerType="software"
                    android:background="@drawable/dashed_line"
                    app:layout_constraintBottom_toBottomOf="@id/dotChest"
                    app:layout_constraintEnd_toStartOf="@id/cardLeftChest"
                    app:layout_constraintStart_toEndOf="@id/dotChest"
                    app:layout_constraintTop_toTopOf="@id/dotChest" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layerType="software"
                    android:background="@drawable/dashed_line"
                    app:layout_constraintBottom_toBottomOf="@id/dotStomach"
                    app:layout_constraintEnd_toStartOf="@id/cardLeftStomach"
                    app:layout_constraintStart_toEndOf="@id/dotStomach"
                    app:layout_constraintTop_toTopOf="@id/dotStomach" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerExercises"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_exercise_panel" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>