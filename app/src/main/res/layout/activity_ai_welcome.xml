<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ai_welcome_gradient">

    <!-- Top Navigation Placeholder -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="24dp"
        android:background="@drawable/bg_circle_white_22"
        android:padding="12dp"
        android:src="@drawable/ic_arrow_right"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/ai_orb_text"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:background="@drawable/bg_ai_version_pill"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI 1.3.2"
            android:textColor="@color/ai_orb_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_chevron_down"
            app:tint="@color/ai_orb_text" />
    </LinearLayout>

    <!-- Central AI Orb Section -->
    <FrameLayout
        android:id="@+id/orbContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="parent">

        <com.example.graduationproject.widget.AiGreetingView
            android:id="@+id/aiGreetingView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="Hi, can I help you?"
            android:textColor="@color/ai_orb_text"
            android:textSize="28sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.1"/>
    </FrameLayout>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.65" />

    <!-- Action Chips Grid -->
    <GridLayout
        android:id="@+id/gridChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:columnCount="2"
        android:rowCount="2"
        app:layout_constraintBottom_toTopOf="@+id/layoutInputBar"
        android:layout_marginBottom="32dp">

        <LinearLayout
            android:id="@+id/chipRewrite"
            style="@style/AiActionChip"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="12dp">
            <ImageView style="@style/AiChipIcon" android:src="@drawable/ic_sparkles" />
            <TextView style="@style/AiChipText" android:text="Rewrite" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chipCreateImage"
            style="@style/AiActionChip"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="12dp">
            <ImageView style="@style/AiChipIcon" android:src="@drawable/ic_gallery" />
            <TextView style="@style/AiChipText" android:text="Create an Image" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chipMakePlan"
            style="@style/AiActionChip"
            android:layout_marginEnd="6dp">
            <ImageView style="@style/AiChipIcon" android:src="@drawable/ic_calendar" />
            <TextView style="@style/AiChipText" android:text="Make a Plan" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chipAnalyseData"
            style="@style/AiActionChip"
            android:layout_marginStart="6dp">
            <ImageView style="@style/AiChipIcon" android:src="@drawable/ic_clock" />
            <TextView style="@style/AiChipText" android:text="Analyse the Data" />
        </LinearLayout>
    </GridLayout>

    <!-- Bottom Input Bar -->
    <LinearLayout
        android:id="@+id/layoutInputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:background="@drawable/bg_ai_input_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_white_1a"
            android:src="@drawable/ic_plus"
            app:tint="@color/ai_orb_text"
            android:contentDescription="@null" />

        <EditText
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Write here..."
            android:textColor="@color/ai_orb_text"
            android:textColorHint="#994A3B69"
            android:textSize="14sp" />

        <ImageButton
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@color/ai_orb_text"
            android:padding="10dp"
            android:src="@drawable/ic_send"
            app:tint="@color/white"
            android:contentDescription="@null" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
