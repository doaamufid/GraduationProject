<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="🪞"
        android:textSize="56sp" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="إعادة الصياغة"
        android:textColor="#1F3A60"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"
        android:text="لنتعلم كيف نرى الأفكار المزعجة\nمن زاوية أكثر إنصافاً لك."
        android:textColor="#8A9CB2"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFromChat"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="14dp"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="30dp"
            app:strokeColor="#E0E0EF"
            app:strokeWidth="1dp"
            android:text="آخر فكرة في المحادثة"
            android:textColor="#7E81BA"
            android:textStyle="bold"
            android:textSize="15sp"
            app:icon="@drawable/ic_chat"
            app:iconGravity="textStart"
            app:iconTint="#7E81BA"
            app:iconPadding="10dp"
            android:textAllCaps="false"
            android:elevation="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWriteNew"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            app:backgroundTint="#7E81BA"
            app:cornerRadius="30dp"
            android:text="كتابة فكرة جديدة"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            app:icon="@drawable/ic_edit"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF"
            app:iconPadding="10dp"
            android:textAllCaps="false"
            android:elevation="4dp" />
    </LinearLayout>
</LinearLayout>
