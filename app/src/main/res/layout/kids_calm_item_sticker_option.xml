<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="66dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true">

    <View
        android:id="@+id/stickerBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/stickerSelectedRing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/kids_calm_bg_sticker_option_selected"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/stickerOptionEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/stickerOptionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#BF2B3A55"
            android:textSize="9sp"
            android:textStyle="bold"
            style="@style/kids_calm_Font.Body" />
    </LinearLayout>
</FrameLayout>
