<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.example.graduationproject.view.KidsAdaptiveSkyBackgroundView
        android:id="@+id/sky_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="4dp">

            <com.example.graduationproject.view.KidsAdaptiveProgressPathView
                android:id="@+id/progress_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true" />

            <TextView
                android:id="@+id/btn_skip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="@string/kids_adaptive_skip"
                android:textColor="@color/kids_adaptive_ink"
                android:alpha="0.6"
                android:textSize="14sp"
                android:padding="8dp" />
        </RelativeLayout>

        <com.example.graduationproject.view.KidsAdaptiveTeddyBuddyView
            android:id="@+id/teddy_header"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:visibility="gone" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/content_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/footer_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="40dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back_footer"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="0.7"
                android:layout_marginEnd="10dp"
                android:backgroundTint="@android:color/transparent"
                app:strokeColor="@color/kids_adaptive_ink_15"
                app:strokeWidth="1.2dp"
                app:cornerRadius="24dp"
                android:textAllCaps="false"
                android:textColor="@color/kids_adaptive_ink"
                android:textSize="14sp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="السابق"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_primary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.3"
                android:backgroundTint="@color/kids_adaptive_sun"
                app:cornerRadius="24dp"
                android:textAllCaps="false"
                android:textColor="#4A2A12"
                android:textSize="16sp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:elevation="4dp"
                android:stateListAnimator="@null"
                android:text="@string/kids_adaptive_btn_continue" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
