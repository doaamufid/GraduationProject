<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.graduationproject.view.KidsAdaptiveSkyBackgroundView
        android:id="@+id/sky_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/kids_adaptive_bg_back_button"
                android:contentDescription="@string/kids_adaptive_back_cd"
                android:src="@android:drawable/ic_media_previous"
                android:scaleType="centerInside"
                android:padding="9dp"
                app:tint="@color/kids_adaptive_ink"
                android:visibility="invisible" />

            <com.example.graduationproject.view.KidsAdaptiveProgressPathView
                android:id="@+id/progress_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true" />

            <TextView
                android:id="@+id/btn_skip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="@string/kids_adaptive_skip"
                android:textColor="@color/kids_adaptive_ink"
                android:alpha="0.6"
                android:textSize="14sp"
                android:padding="6dp" />
        </RelativeLayout>

        <com.example.graduationproject.view.KidsAdaptiveTeddyBuddyView
            android:id="@+id/teddy_header"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="16dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/content_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="10dp"
            android:paddingBottom="26dp">

            <Button
                android:id="@+id/btn_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/kids_adaptive_bg_primary_button"
                android:textAllCaps="false"
                android:textColor="#4A2A12"
                android:textSize="18sp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:elevation="4dp"
                android:text="@string/kids_adaptive_btn_continue" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
