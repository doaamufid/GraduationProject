<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#3A5A40"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎉 🌿 ✨ 🌟 🍃"
        android:textSize="28sp" />

    <!-- إيموجي المرحلة التي وصل لها الطفل -->
    <TextView
        android:id="@+id/tvTreeLevelEmoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="🌳"
        android:textSize="110sp" />

    <!-- عنوان إنجاز المرحلة -->
    <TextView
        android:id="@+id/tvLevelUpTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="مبروك! أنهيت المرحلة بنجاح 🎉"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- اسم المرحلة الجديدة/الحالية -->
    <TextView
        android:id="@+id/tvLevelUpSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="أنت الآن في مرحلة: الشجرة النامية"
        android:textColor="#DAD7CD"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- رسالة تشجيعية -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="شجرتك كبرت وبدأت تزهو بسبب كل تمارينك واهتمامك! 💚\nاستمر بالاهتمام بها لتثمر أكثر."
        android:textColor="#A3B18A"
        android:textSize="14sp" />

    <!-- زر استلام المكافأة والعودة -->
    <Button
        android:id="@+id/btnClaimReward"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="40dp"
        android:backgroundTint="#FFFFFF"
        android:text="استلام المكافأة ومتابعة النمو! 🌟"
        android:textColor="#3A5A40"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="28dp" />

</LinearLayout>