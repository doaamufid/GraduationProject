<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/readerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@color/bg">

    <!-- Hero Banner Header -->
    <FrameLayout
        android:id="@+id/heroContainer"
        android:layout_width="match_parent"
        android:layout_height="320dp">

        <com.example.graduationproject.ui.WaveArtView
            android:id="@+id/waveArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Soft Blur/Fade effect at the bottom -->
        <View
            android:id="@+id/heroFade"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_gravity="bottom"
            android:background="@drawable/gradient_hero_fade" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="40dp">

            <!-- Top Action Bar (Inside ScrollView) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="32dp"
                android:paddingBottom="12dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle_surface"
                    android:backgroundTint="#40FFFFFF"
                    android:padding="11dp"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/text" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btnFavorite"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_circle_surface"
                    android:backgroundTint="#40FFFFFF"
                    android:padding="11dp"
                    android:src="@drawable/ic_heart_outline"
                    app:tint="@color/text" />

                <ImageButton
                    android:id="@+id/btnBookmark"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_circle_surface"
                    android:backgroundTint="#40FFFFFF"
                    android:padding="11dp"
                    android:src="@drawable/ic_bookmark"
                    app:tint="@color/text" />

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp">

                    <ImageButton
                        android:id="@+id/btnNotes"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_circle_surface"
                        android:backgroundTint="#40FFFFFF"
                        android:padding="11dp"
                        android:src="@drawable/ic_file_text"
                        app:tint="@color/text" />

                    <TextView
                        android:id="@+id/badgeCount"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="-2dp"
                        android:layout_marginTop="-2dp"
                        android:background="@drawable/bg_badge_rose"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="2" />
                </FrameLayout>

                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_circle_surface"
                    android:backgroundTint="#40FFFFFF"
                    android:padding="11dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/text" />
            </LinearLayout>

            <!-- Spacer to show the hero header -->
            <View
                android:layout_width="match_parent"
                android:layout_height="140dp" />

            <!-- Category Icon -->
            <TextView
                android:id="@+id/tvCategoryIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-20dp"
                android:layout_marginBottom="12dp"
                android:textSize="18sp"
                tools:text="✨" />

            <!-- Meta Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|start"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvCategoryPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hint_box"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/textSoft"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    tools:text="مبادئ" />

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:alpha="0.7"
                    android:drawableStart="@drawable/ic_clock_small"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/text"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    tools:text="٦ دقائق" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:gravity="start"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="ما هو CBT وكيف يساعدك؟" />

            <TextView
                android:id="@+id/tvAuthor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:alpha="0.6"
                android:gravity="start"
                android:textColor="@color/text"
                android:textSize="12sp"
                tools:text="بقلم د. سلمى فهد" />

            <!-- Body -->
            <LinearLayout
                android:id="@+id/bodyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:orientation="vertical" />

            <!-- Related Exercise Card -->
            <LinearLayout
                android:id="@+id/groupRelatedExercise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_card_shape"
                android:backgroundTint="#EAF2FC"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="جرب الفكرة عملياً"
                        android:textColor="@color/primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRelatedLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="إعادة الصياغة" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_card_shape"
                    android:backgroundTint="#D0E2F5">

                    <ImageView
                        android:id="@+id/ivRelatedIcon"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_star"
                        app:tint="@color/primary" />
                </FrameLayout>
            </LinearLayout>

            <!-- Feedback Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:text="شو رأيك بهالمقالة؟"
                        android:textColor="@color/text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnThumbDown"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_circle_surface"
                            android:padding="11dp"
                            android:src="@drawable/ic_thumb_down"
                            app:tint="@color/textSoft" />

                        <ImageButton
                            android:id="@+id/btnThumbUp"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_circle_surface"
                            android:padding="11dp"
                            android:src="@drawable/ic_thumb_up"
                            app:tint="@color/textSoft" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Reasons Panel -->
            <LinearLayout
                android:id="@+id/groupReasons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_shape"
                android:backgroundTint="#F0F3F7"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="start"
                    android:text="وش السبب؟ (اختياري)"
                    android:textColor="@color/text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupReasons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp"
                    android:layoutDirection="rtl" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Overlay for brightness -->
    <View
        android:id="@+id/brightnessOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/black"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <!-- Toast View -->
    <TextView
        android:id="@+id/toastView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="24dp"
        android:background="@drawable/bg_toast"
        android:elevation="8dp"
        android:gravity="center"
        android:padding="14dp"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="تم الحفظ ✨" />

</RelativeLayout>
