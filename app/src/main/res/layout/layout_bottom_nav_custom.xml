<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/customBottomNav"
    android:layout_width="wrap_content"
    android:layout_height="64dp"
    android:layout_gravity="center_horizontal"
    android:layout_marginBottom="24dp"
    android:layout_marginHorizontal="24dp"
    android:background="@drawable/bg_bottom_nav_custom"
    android:elevation="8dp"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp">

    <!-- Home -->
    <RelativeLayout
        android:id="@+id/nav_home"
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true">

        <View
            android:id="@+id/nav_home_bg"
            android:layout_width="64dp"
            android:layout_height="40dp"
            android:layout_centerInParent="true"
            android:background="@drawable/nav_item_selected_bg"
            android:visibility="invisible" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_home_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home"
                android:contentDescription="@null"
                app:tint="@color/nav_item_colors" />

            <TextView
                android:id="@+id/nav_home_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الرئيسية"
                android:textSize="11sp"
                android:textColor="@color/nav_item_colors"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </RelativeLayout>

    <!-- Exercises -->
    <RelativeLayout
        android:id="@+id/nav_exercises"
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true">

        <View
            android:id="@+id/nav_exercises_bg"
            android:layout_width="64dp"
            android:layout_height="40dp"
            android:layout_centerInParent="true"
            android:background="@drawable/nav_item_selected_bg"
            android:visibility="invisible" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_exercises_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_activity"
                android:contentDescription="@null"
                app:tint="@color/nav_item_colors" />

            <TextView
                android:id="@+id/nav_exercises_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تمارين"
                android:textSize="11sp"
                android:textColor="@color/nav_item_colors"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </RelativeLayout>

    <!-- Companion -->
    <RelativeLayout
        android:id="@+id/nav_friend"
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true">

        <View
            android:id="@+id/nav_friend_bg"
            android:layout_width="64dp"
            android:layout_height="40dp"
            android:layout_centerInParent="true"
            android:background="@drawable/nav_item_selected_bg"
            android:visibility="invisible" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_friend_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chat"
                android:contentDescription="@null"
                app:tint="@color/nav_item_colors" />

            <TextView
                android:id="@+id/nav_friend_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="رفيقي"
                android:textSize="11sp"
                android:textColor="@color/nav_item_colors"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </RelativeLayout>

    <!-- Profile -->
    <RelativeLayout
        android:id="@+id/nav_profile"
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true">

        <View
            android:id="@+id/nav_profile_bg"
            android:layout_width="64dp"
            android:layout_height="40dp"
            android:layout_centerInParent="true"
            android:background="@drawable/nav_item_selected_bg"
            android:visibility="invisible" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_profile_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_user"
                android:contentDescription="@null"
                app:tint="@color/nav_item_colors" />

            <TextView
                android:id="@+id/nav_profile_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="أنا"
                android:textSize="11sp"
                android:textColor="@color/nav_item_colors"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </RelativeLayout>

</LinearLayout>