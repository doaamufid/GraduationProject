<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@color/screen_bg">

    <!-- Full-bleed illustrated scene (mountain / sea / forest / desert) + scrim -->
    <com.example.graduationproject.ui.SceneView
        android:id="@+id/scene_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Foreground content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar: next/enter pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <LinearLayout
                android:id="@+id/btn_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_pill_white"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/txt_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/next_button"
                    android:textColor="@color/black_1a"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_button"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Title area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="32dp">

            <TextView
                android:id="@+id/txt_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="@dimen/text_title"
                android:layout_marginBottom="4dp"
                tools:text="سكون القمة"
                xmlns:tools="http://schemas.android.com/tools"/>

            <TextView
                android:id="@+id/txt_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:alpha="0.75"
                android:textStyle="bold"
                android:textSize="@dimen/text_tag"
                android:letterSpacing="0.12"
                tools:text="لحظة تأمل"/>
        </LinearLayout>

        <!-- Spacer pushes chip + note card + dots to the bottom (mirrors mt-auto) -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- Ambiance chip -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/txt_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_translucent"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="@dimen/text_chip"
                tools:text="🌫️ هادئ"
                xmlns:tools="http://schemas.android.com/tools"/>
        </LinearLayout>

        <!-- Diary note card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="start|center_vertical">

                    <TextView
                        android:id="@+id/txt_note_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:alpha="0.7"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_note_label"
                        android:letterSpacing="0.05"
                        android:layout_marginEnd="8dp"
                        tools:text="ملاحظة اليوم · ٨ أبريل"
                        xmlns:tools="http://schemas.android.com/tools"/>

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:text="💧"
                        android:textSize="13sp"
                        android:background="@drawable/bg_circle_translucent_33"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/txt_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="@dimen/text_note"
                android:lineSpacingMultiplier="1.3"
                android:gravity="end"
                tools:text="نص الملاحظة هنا"
                xmlns:tools="http://schemas.android.com/tools"/>
        </LinearLayout>



    </LinearLayout>
</FrameLayout>
