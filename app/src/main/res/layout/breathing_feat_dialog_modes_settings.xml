<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="600dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="#D8DED9" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">

            <TextView
                android:id="@+id/tabModes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_accent"
                android:gravity="center"
                android:paddingVertical="9dp"
                android:text="الأنماط"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabSettings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_hub_item"
                android:gravity="center"
                android:paddingVertical="9dp"
                android:text="الإعدادات"
                android:textColor="@color/hub_sub"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/modesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/settingsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_hub_item"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="الوضع الليلي" android:textColor="@color/hub_title" android:textStyle="bold" android:textSize="13.5sp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="ألوان خضراء داكنة مريحة للعين ليلاً" android:textColor="@color/hub_desc" android:textSize="11sp"/>
                </LinearLayout>

                <Switch
                    android:id="@+id/switchDark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_hub_item"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="تذكير يومي" android:textColor="@color/hub_title" android:textStyle="bold" android:textSize="13.5sp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="إشعار يومي بوقت ثابت لتذكيرك بجلستك" android:textColor="@color/hub_desc" android:textSize="11sp"/>
                </LinearLayout>

                <Switch
                    android:id="@+id/switchReminder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/reminderTimeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_hub_item"
                android:gravity="center"
                android:padding="12dp"
                android:textColor="@color/hub_title"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="وقت التذكير: 20:00"
                xmlns:tools="http://schemas.android.com/tools" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="طريقة تحديد مدة الجلسة"
                android:textColor="@color/hub_sub"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnLengthMinutes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_accent"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:text="بالدقائق"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnLengthCycles"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_hub_item"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:text="بعدد الدورات"
                    android:textColor="@color/hub_sub"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cyclesTargetRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hub_item"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btnCyclesMinus"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_pill_white"
                    android:gravity="center"
                    android:text="−"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/cyclesTargetText"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/hub_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="10"
                    xmlns:tools="http://schemas.android.com/tools" />

                <TextView
                    android:id="@+id/btnCyclesPlus"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_pill_white"
                    android:gravity="center"
                    android:text="+"
                    android:textSize="18sp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
