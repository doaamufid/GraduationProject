<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:layoutDirection="rtl"
    tools:context=".BreathingActivity">

    <!-- شريط الرأس المطور -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="65dp"
        android:background="@color/bg"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- زر العودة على اليمين -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/outline_arrow_forward_24"
            android:padding="8dp"
            app:tint="@color/text_main"
            android:background="@drawable/bg_icon_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="رجوع" />

        <!-- العنوان والترجمة في المنتصف -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تمارين التنفس"
                android:textColor="#2D5B7B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="تمرين الصفاء الذهني"
                android:textColor="#99AAB5"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- زر الإعدادات المبتكر -->
        <LinearLayout
            android:id="@+id/btnSessionSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/baseline_more_vert_24"
                app:tint="#6A8CA3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="اعدادات الجلسة"
                android:textColor="#6A8CA3"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- الـ ScrollView تم إزالته لجعل الشاشة غير قابلة للتمرير وتقليل المحتوى -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/innerConstraintLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/btnStartBreathing"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <TextView
            android:id="@+id/tvMainTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="خذ نفساً معي"
            android:textColor="#2D5B7B"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSubTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="دورة من ٣ - ٥ "
            android:textColor="#6A8CA3"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="@id/tvMainTitle"
            app:layout_constraintStart_toStartOf="@id/tvMainTitle"
            app:layout_constraintTop_toBottomOf="@id/tvMainTitle" />

        <TextView
            android:id="@+id/tvDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="الكلاسيكي . بدون هدف إلزامي . استمر أينما ترتاح"
            android:textColor="#99AAB5"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubTitle" />

        <!-- الفريمProgress محاذاته مرنة ومريحة في منتصف الشاشة -->
        <FrameLayout
            android:id="@+id/frameProgress"
            android:layout_width="260dp"
            android:layout_height="260dp"
            app:layout_constraintBottom_toTopOf="@+id/layoutAnchor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDesc">

            <!-- Outer faint background ring -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_breathing_middle"
                android:alpha="0.3" />

            <!-- Outer segmented ring -->
            <ImageView
                android:id="@+id/imgOuterRing"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="2dp"
                android:src="@drawable/bg_breathing_outer" />

            <!-- Middle ring -->
            <ImageView
                android:id="@+id/imgMiddleRing"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="25dp"
                android:src="@drawable/bg_breathing_middle" />

            <!-- Progress Ring -->
            <ProgressBar
                android:id="@+id/breathingProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="25dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/circle_outer"
                android:visibility="gone"/>

            <!-- Center white circle -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="35dp"
                android:background="@drawable/bg_breathing_center"
                android:elevation="4dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:elevation="5dp">

                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4"
                    android:textColor="#2D5B7B"
                    android:textSize="80sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="شهيق"
                    android:textColor="#6A8CA3"
                    android:textSize="20sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/layoutAnchor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/white_rounded_card"
            android:orientation="vertical"
            android:padding="12dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="بطاقتك الشخصية"
                android:textColor="#99AAB5"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="&quot;خذ وقتك، ما فيه استعجال&quot;"
                android:textColor="#2D5B7B"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- تم إخفاء البطاقة الثانية لتقليل المحتوى وضمان ملاءمة الشاشة -->
        <LinearLayout
            android:id="@+id/layoutAnchor2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/layoutAnchor" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- تم رفع الـ marginBottom لـ 32dp ليرتفع الزر عن حافة النظام السفلية ويكون مريحاً جداً -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnStartBreathing"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="60dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/white_rounded_card"
        android:backgroundTint="#4A7EBB"
        android:text="ابدأ الجلسة"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>