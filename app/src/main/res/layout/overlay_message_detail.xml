<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/dialog_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_dialog_rounded"
        android:padding="24dp">

        <ImageView
            android:id="@+id/img_dialog_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="@null"
            tools:src="@drawable/ic_mail"/>

        <TextView
            android:id="@+id/txt_dialog_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_main"
            android:textStyle="bold"
            android:textSize="@dimen/text_title2"
            android:lineSpacingMultiplier="1.3"
            android:gravity="center"
            android:layout_marginBottom="20dp"
            tools:text="نص رسالة المستقبل هنا"/>

        <Button
            android:id="@+id/btn_dialog_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@drawable/bg_button_primary"
            android:text="@string/close_button"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="@dimen/text_body2"
            android:elevation="0dp"
            android:stateListAnimator="@null"/>

    </LinearLayout>
</FrameLayout>
