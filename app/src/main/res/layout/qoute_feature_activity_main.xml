<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/outerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/qoute_feature_bg_outer_radial">

    <!-- ============ PHONE FRAME ============ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/phoneFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@drawable/qoute_feature_bg_phone_frame"
        android:clipChildren="true"
        android:clipToPadding="true">

        <!-- Background image with Ken Burns animation -->
        <ImageView
            android:id="@+id/bgImage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Dark gradient overlay -->
        <View
            android:id="@+id/overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/qoute_feature_bg_overlay_gradient"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Floating gold dust particles -->
        <com.example.graduationproject.view.QouteFeatureParticleView
            android:id="@+id/particleView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ============ BOTTOM CONTENT ============ -->
        <LinearLayout
            android:id="@+id/contentBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="26dp"
            android:paddingBottom="30dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/greetLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="صباح الخير ✦"
                android:textColor="@color/qoute_feature_muted"
                android:textSize="15sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/dayLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الأحد"
                android:textColor="@color/qoute_feature_gold_light"
                android:textStyle="bold"
                android:textSize="40sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/dateLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="يناير 1 — 12:00 ص"
                android:textColor="@color/qoute_feature_muted"
                android:textSize="14sp"
                android:layout_marginBottom="20dp" />

            <!-- Quote card with breathing glow -->
            <FrameLayout
                android:id="@+id/quoteCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="96dp">

                <View
                    android:id="@+id/breathGlow"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="-14dp"
                    android:background="@drawable/qoute_feature_bg_breath_glow" />

                <TextView
                    android:id="@+id/quoteText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:paddingStart="6dp"
                    android:text=""
                    android:textColor="@color/qoute_feature_cream"
                    android:textSize="16.5sp"
                    android:lineSpacingMultiplier="1.3" />
            </FrameLayout>

            <!-- CTA button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_horizontal">

                <Button
                    android:id="@+id/ctaBtn"
                    android:layout_width="220dp"
                    android:layout_height="48dp"
                    android:text="دخول"
                    android:textColor="@color/qoute_feature_cta_text"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:letterSpacing="0.1"
                    android:paddingVertical="0dp"
                    android:background="@drawable/qoute_feature_bg_cta_btn"
                    app:backgroundTint="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:elevation="4dp"
                    android:alpha="0"
                    android:visibility="invisible" />
            </LinearLayout>

            <!-- Social row: like / share / save -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/likeBtn"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/qoute_feature_bg_icon_btn">
                    <ImageView
                        android:id="@+id/likeIcon"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_gravity="center"
                        android:src="@drawable/qoute_feature_ic_heart" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/shareBtn"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/qoute_feature_bg_icon_btn">
                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_gravity="center"
                        android:src="@drawable/qoute_feature_ic_share" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/saveBtn"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/qoute_feature_bg_icon_btn">
                    <ImageView
                        android:id="@+id/saveIcon"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_gravity="center"
                        android:src="@drawable/qoute_feature_ic_bookmark" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Toast -->
        <TextView
            android:id="@+id/toastView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/qoute_feature_bg_toast"
            android:paddingHorizontal="18dp"
            android:paddingVertical="9dp"
            android:text=""
            android:textColor="@color/qoute_feature_gold_light"
            android:textSize="12.5sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
