<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/breathing_feat_breathe_light_bg1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:background="@drawable/bg_pill_white"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/back_to_home"
                android:textColor="@color/green_mid"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnDarkToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_pill_white"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="@string/breathing_feat_dark_mode_toggle"
                android:textColor="@color/hub_sub"
                android:textSize="12sp" />
        </RelativeLayout>

        <!-- audience toggle: kids / adult -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_white"
            android:orientation="horizontal"
            android:padding="5dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:id="@+id/btnAudienceKids"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_accent"
                android:paddingHorizontal="18dp"
                android:paddingVertical="9dp"
                android:text="🧒 أطفال"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAudienceAdult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="18dp"
                android:paddingVertical="9dp"
                android:text="🧑 كبار"
                android:textColor="@color/hub_sub"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/routineTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/breathing_feat_routine_title_progress"
            android:textColor="@color/green_deep"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/routineSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/hub_sub"
            android:textSize="13sp"
            tools:text="0 من 4 تمارين تنفس مكتملة"
            xmlns:tools="http://schemas.android.com/tools" />

        <TextView
            android:id="@+id/routineStreak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_pill_white"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:textColor="#E4685C"
            android:textStyle="bold"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="🔥 3 أيام متتالية"
            xmlns:tools="http://schemas.android.com/tools" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/white"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <com.example.graduationproject.view.BreathingFeatRoutineProgressView
                    android:id="@+id/routineProgressView"
                    android:layout_width="match_parent"
                    android:layout_height="110dp" />

                <TextView
                    android:id="@+id/btnCta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_pill_accent"
                    android:gravity="center"
                    android:paddingVertical="14dp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    tools:text="ابدئي: التنفس المتساوي ✨"
                    xmlns:tools="http://schemas.android.com/tools" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/green_soft"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:gravity="center"
                android:text="@string/breathing_feat_routine_quote"
                android:textColor="@color/green_deep"
                android:textStyle="bold"
                android:textSize="13sp" />
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
