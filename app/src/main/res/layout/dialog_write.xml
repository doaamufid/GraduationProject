<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_sheet"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header: close (X) + title -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <ImageButton
            android:id="@+id/btnCloseDialog"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentStart="true"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_close"
            app:tint="@color/text_soft"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/write_title"
            android:textColor="@color/text_main"
            android:textSize="14sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Text / Voice mode tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_tab_selected"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/mode_text"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabVoice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_tab_unselected"
            android:drawablePadding="4dp"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/mode_voice"
            android:textColor="@color/text_main"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Text-entry mode -->
    <EditText
        android:id="@+id/etThoughtText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_input_field"
        android:gravity="top|end"
        android:hint="@string/write_hint"
        android:textColorHint="@color/text_soft"
        android:inputType="textMultiLine"
        android:minLines="4"
        android:padding="16dp"
        android:textColor="@color/text_main"
        android:textSize="13sp" />

    <!-- Voice-entry mode (hidden unless voice tab selected) -->
    <LinearLayout
        android:id="@+id/voiceModeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/btnMic"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_mic_circle"
            android:padding="20dp"
            android:src="@drawable/ic_mic"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/voice_hint"
            android:textColor="@color/text_soft"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/etThoughtVoiceAlt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_field"
            android:gravity="end"
            android:hint="@string/voice_alt_hint"
            android:textColorHint="@color/text_soft"
            android:inputType="text"
            android:padding="10dp"
            android:textColor="@color/text_main"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Emotion tags -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="end"
        android:text="@string/emotions_label"
        android:textColor="@color/text_main"
        android:textSize="11sp"
        android:textStyle="bold" />

    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/emotionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:flexWrap="wrap"
        app:justifyContent="flex_end" />

    <!-- Submit -->
    <Button
        android:id="@+id/btnAnalyze"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:enabled="false"
        style="@style/Button.Primary"
        android:text="@string/analyze_button" />

</LinearLayout>
