<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_alert_box"
    android:padding="14dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/txt_alert_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_main"
            android:textStyle="bold"
            android:textSize="@dimen/text_body2"
            tools:text="تكرار دخول غرفة الأمان"/>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_alert_triangle"
            android:layout_marginEnd="6dp"
            android:contentDescription="@null"/>

        <ImageView
            android:id="@+id/img_alert_chevron"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_chevron_down"
            android:contentDescription="@null"/>
    </LinearLayout>

    <TextView
        android:id="@+id/txt_alert_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_soft"
        android:textSize="@dimen/text_body"
        android:gravity="start"
        tools:text="نص التنبيه هنا"/>

    <View
        android:id="@+id/alert_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        tools:visibility="visible"/>

    <TextView
        android:id="@+id/txt_alert_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_soft"
        android:textSize="@dimen/text_small"
        android:gravity="start"
        android:paddingTop="8dp"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="تفاصيل إضافية عن التنبيه"/>

</LinearLayout>
