<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="560dp"
    android:background="@drawable/kids_calm_bg_dialog_sheet_mint"
    android:padding="20dp"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:text="@string/kids_calm_dialog_new_word_title"
            android:textColor="@color/kids_calm_navy"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp"
            style="@style/kids_calm_Font.Display" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:text="@string/kids_calm_dialog_word_label"
            android:textColor="@color/kids_calm_navy"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            style="@style/kids_calm_Font.Display" />

        <EditText
            android:id="@+id/wordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:gravity="top|start"
            android:maxLength="40"
            android:background="@drawable/kids_calm_bg_pill_outline"
            android:padding="12dp"
            android:hint="@string/kids_calm_dialog_word_hint"
            android:textColor="@color/kids_calm_navy"
            android:textColorHint="@color/kids_calm_navySoft"
            android:textSize="14sp"
            style="@style/kids_calm_Font.Body" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:text="@string/kids_calm_dialog_emoji_label"
            android:textColor="@color/kids_calm_navy"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            style="@style/kids_calm_Font.Display" />

        <GridLayout
            android:id="@+id/emojiRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:text="@string/kids_calm_dialog_dur_label"
            android:textColor="@color/kids_calm_navy"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            style="@style/kids_calm_Font.Display" />

        <LinearLayout
            android:id="@+id/wordDurChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <TextView
                android:id="@+id/wordCancelButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/kids_calm_bg_ghost_button"
                android:gravity="center"
                android:paddingVertical="13dp"
                android:text="@string/kids_calm_dialog_cancel"
                android:textColor="@color/kids_calm_navy"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                style="@style/kids_calm_Font.Display" />

            <TextView
                android:id="@+id/wordSaveButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/kids_calm_bg_big_button_disabled"
                android:gravity="center"
                android:paddingVertical="13dp"
                android:text="@string/kids_calm_dialog_save_word"
                android:textColor="@color/kids_calm_navySoft"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                style="@style/kids_calm_Font.Display" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
