<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_related_card"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvRelatedLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_white"
            android:textStyle="bold"
            android:textSize="15sp"
            tools:text="الانضباط"/>

        <View
            android:id="@+id/dotColor"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_dot_solid"
            tools:background="#D9A85C"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvRelatedReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/text_soft"
        android:textSize="13sp"
        android:lineSpacingMultiplier="1.3"
        android:layout_marginBottom="12dp"
        tools:text="الإصرار غالباً يرافقه الانضباط — قدرتك على الالتزام بروتين حتى لو ما حسيت بالحافز."/>

    <LinearLayout
        android:id="@+id/relatedSuggestionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_tintable_card"
        android:padding="12dp">

        <TextView
            android:id="@+id/btnStartRelated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tintable_pill"
            android:text="@string/start_btn"
            android:textColor="@color/text_white"
            android:textStyle="bold"
            android:textSize="12sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:focusable="true"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tvRelatedTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exercise_tag"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:textColor="#D9A85C"/>

            <TextView
                android:id="@+id/tvRelatedSuggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                tools:text="حدد هدف صغير كل يوم وتابعه لمدة أسبوع كامل"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
