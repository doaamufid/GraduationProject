<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgDeep">

    <LinearLayout
        android:id="@+id/rootColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bgMid">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="22dp"
            android:paddingBottom="10dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/appTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/cream"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:id="@+id/appSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/mutedDim"
                    android:textSize="11.5sp"/>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnInfo"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_icon_circle"
                android:src="@android:drawable/ic_menu_help"
                app:tint="@color/amber"
                android:contentDescription="@string/info_desc"
                android:padding="6dp"
                android:scaleType="fitCenter"/>
        </LinearLayout>

        <!-- Tabs -->
        <LinearLayout
            android:id="@+id/tabBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="14dp"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/tabGallery"
                style="@style/TabButtonStyle"
                android:text="@string/tab_gallery"/>

            <TextView
                android:id="@+id/tabDhikr"
                style="@style/TabButtonStyle"
                android:layout_marginStart="6dp"
                android:text="@string/tab_dhikr"/>

            <TextView
                android:id="@+id/tabSimulate"
                style="@style/TabButtonStyle"
                android:layout_marginStart="6dp"
                android:text="@string/tab_simulate"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#0FFFFFFF"/>

        <!-- Content -->
        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>

    <!-- Toast -->
    <TextView
        android:id="@+id/toastView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="26dp"
        android:background="@drawable/bg_toast"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="@color/cream"
        android:textSize="13.5sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:elevation="12dp"/>

</FrameLayout>
