<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="locale"
    android:background="@drawable/bg_card_rounded">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical|end"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:text="@string/item_approved_card_android_text_0"
                android:textSize="13sp"
                android:gravity="center"
                android:background="@drawable/bg_white88_circle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/community_person"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/approvedCardText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text"
            android:lineSpacingMultiplier="1.25" />
    </LinearLayout>

    <TextView
        android:id="@+id/approvedCardEmoji"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:background="@drawable/bg_whitecc_circle"
        android:gravity="center"
        android:textSize="14sp"
        android:visibility="gone" />

</FrameLayout>
