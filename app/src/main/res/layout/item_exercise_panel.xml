<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_suggestion_btn"
    android:padding="12dp">

    <!-- Header / Closed State -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btnArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/viewAreaDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/circle_outer"
            app:layout_constraintBottom_toBottomOf="@id/tvTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvTitle" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:gravity="end"
            android:textColor="#3A6898"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/viewAreaDot"
            app:layout_constraintStart_toEndOf="@id/leftHeaderContainer"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="الرأس والرقبة" />

        <LinearLayout
            android:id="@+id/leftHeaderContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvTitle">

            <TextView
                android:id="@+id/tvTryCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_accent_round"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="#3A6898"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="جربتها ٢ مرات"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#7F8C8D"
                android:textSize="14sp"
                tools:text="صداع • توتر" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Expanded State Details -->
    <LinearLayout
        android:id="@+id/cardExercise"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_note_input"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/btnArea"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvExerciseTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:textColor="#B7950B"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="تمرين • الرأس والرقبة" />

        <TextView
            android:id="@+id/tvExerciseTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:textColor="#3A6898"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="تمرين الرقبة - تحرير التوتر" />

        <TextView
            android:id="@+id/tvExerciseDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:textColor="#566573"
            android:textSize="16sp"
            tools:text="أدر رأسك ببطء لليمين ثم لليسار، وخذ نفساً عميقاً مع كل حركة. كرر ٣ مرات بلطف." />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvReps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_accent_round"
                android:backgroundTint="#FFFFFF"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#7F8C8D"
                android:textSize="12sp"
                tools:text="٣ مرات" />

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_pill_accent_round"
                android:backgroundTint="#FFFFFF"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#7F8C8D"
                android:textSize="12sp"
                tools:text="١ دقائق 🕒" />

            <TextView
                android:id="@+id/tvOffline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_accent_round"
                android:backgroundTint="#FFFFFF"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#7F8C8D"
                android:textSize="12sp"
                tools:text="offline 🚫" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_pill_primary"
            android:backgroundTint="#3A6898"
            android:text="@string/item_exercise_panel_android_text_0"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>