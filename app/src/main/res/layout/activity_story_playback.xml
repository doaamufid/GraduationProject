<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- خلفية الفيديو الصامتة المتكررة (loop) -->
    <VideoView
        android:id="@+id/backgroundVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- طبقة تعتيم بسيطة فوق الفيديو عشان النص يبين بوضوح -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <!-- زر الرجوع -->
    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:contentDescription="رجوع"
        android:tint="@android:color/white" />

    <!-- مؤشر التحميل أثناء توليد القصة -->
    <LinearLayout
        android:id="@+id/loadingLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="عم نحضّرلك قصة حلوة..."
            android:textColor="@android:color/white"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- نص القصة (تحت، فوق الفيديو) -->
    <ScrollView
        android:id="@+id/storyScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_above="@+id/controlsLayout"
        android:layout_marginBottom="12dp"
        android:maxHeight="220dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/storyTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textAlignment="center"
            android:lineSpacingExtra="6dp" />
    </ScrollView>

    <!-- أزرار التحكم أسفل الشاشة -->
    <LinearLayout
        android:id="@+id/controlsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone">

        <Button
            android:id="@+id/replayButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="🔁 اسمعها بعد" />

        <Button
            android:id="@+id/newStoryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨ قصة جديدة" />
    </LinearLayout>

</RelativeLayout>
