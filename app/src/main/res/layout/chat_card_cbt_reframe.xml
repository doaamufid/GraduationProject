<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/chat_card_max_width"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_suggestion_card"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="start">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_cbt_reframe_kicker"
                android:textColor="@color/text_soft"
                android:textStyle="bold"
                android:textSize="9sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_cbt_reframe_title"
                android:textColor="@color/text_main"
                android:textStyle="bold"
                android:textSize="@dimen/chat_text_body"/>
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_search"
            android:contentDescription="@null"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/chat_cbt_reframe_desc"
        android:textColor="@color/text_soft"
        android:textSize="@dimen/chat_text_chip"
        android:gravity="start"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btn_card_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/bg_button_sage"
        android:text="@string/chat_cbt_reframe_button"
        android:textColor="@color/white"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textSize="@dimen/chat_text_chip"
        android:elevation="0dp"
        android:stateListAnimator="@null"/>

</LinearLayout>
