<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.example.graduationproject.view.kidsCalmMascotView
        android:id="@+id/galleryMascot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/activeCardLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="viewStart"
        android:layout_marginTop="16dp"
        android:text="@string/kids_calm_gallery_active_label"
        android:textColor="@color/kids_calm_coralDeep"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        style="@style/kids_calm_Font.Display" />

    <com.example.graduationproject.view.kidsCalmKidCardView
        android:id="@+id/activeKidCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/emptyStateText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/kids_calm_bg_dashed_empty"
        android:gravity="center"
        android:padding="18dp"
        android:text="@string/kids_calm_gallery_empty"
        android:textColor="@color/kids_calm_navySoft"
        android:textSize="13sp"
        android:visibility="gone"
        style="@style/kids_calm_Font.Body" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="viewStart"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="10dp"
        android:text="@string/kids_calm_gallery_all_cards"
        android:textColor="@color/kids_calm_navy"
        android:textSize="13.5sp"
        android:textStyle="bold"
        style="@style/kids_calm_Font.Display" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/cardsRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:nestedScrollingEnabled="true"
        android:clipChildren="true"
        android:clipToPadding="true"
        tools:listitem="@layout/kids_calm_item_card" />

    <TextView
        android:id="@+id/newCardButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/kids_calm_bg_big_button_coral"
        android:gravity="center"
        android:paddingVertical="15dp"
        android:text="@string/kids_calm_gallery_new_card"
        android:textColor="@color/kids_calm_white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:elevation="4dp"
        android:clickable="true"
        android:focusable="true"
        style="@style/kids_calm_Font.Display" />

</LinearLayout>
