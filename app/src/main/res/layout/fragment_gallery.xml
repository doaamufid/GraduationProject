<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Active card section -->
        <LinearLayout
            android:id="@+id/activeCardSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="22dp">

            <TextView
                android:id="@+id/activeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/active_now_label"
                android:textColor="@color/amber"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <com.example.graduationproject.view.CalmCardView
                android:id="@+id/activeCalmCard"
                android:layout_width="match_parent"
                android:layout_height="168dp"/>
        </LinearLayout>

        <!-- Empty state (no active card) -->
        <TextView
            android:id="@+id/noActiveState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_active_card"
            android:textColor="@color/mutedDim"
            android:textSize="13sp"
            android:gravity="center"
            android:padding="18dp"
            android:background="@drawable/bg_btn_dashed"
            android:layout_marginBottom="22dp"
            android:visibility="gone"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/all_cards"
            android:textColor="@color/cream"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cardsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>

        <TextView
            android:id="@+id/btnNewCard"
            style="@style/GhostButton"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_dashed"
            android:textColor="@color/amber"
            android:text="@string/new_card_btn"/>

    </LinearLayout>
</ScrollView>
