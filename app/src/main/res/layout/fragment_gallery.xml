<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:paddingBottom="90dp"
            android:clipToPadding="false">

            <!-- Active card section -->
            <LinearLayout
                android:id="@+id/activeCardSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="22dp">

                <TextView
                    android:id="@+id/activeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/active_now_label"
                    android:textColor="@color/primary"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <com.example.graduationproject.view.CalmCardView
                    android:id="@+id/activeCalmCard"
                    android:layout_width="match_parent"
                    android:layout_height="168dp"/>
            </LinearLayout>

            <!-- Empty state (no active card) -->
            <TextView
                android:id="@+id/noActiveState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_active_card"
                android:textColor="@color/text_soft"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="18dp"
                android:background="@drawable/bg_btn_dashed"
                android:layout_marginBottom="22dp"
                android:visibility="gone"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/all_cards"
                android:textColor="@color/text_main"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/cardsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNewCard"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        app:backgroundTint="@color/white"
        app:cornerRadius="28dp"
        android:text="@string/new_card_btn"
        android:textAllCaps="false"
        android:textColor="@color/primary"
        android:textStyle="bold"
        android:textSize="14sp"
        app:icon="@drawable/ic_plus"
        app:iconTint="@color/primary"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        android:elevation="8dp"
        android:stateListAnimator="@null"
        android:paddingStart="24dp"
        android:paddingEnd="24dp" />

</FrameLayout>
