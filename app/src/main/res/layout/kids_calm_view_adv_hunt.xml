<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center">

    <com.example.graduationproject.view.kidsCalmMascotView
        android:id="@+id/huntMascot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/huntCompass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/kids_calm_icon_compass"
        android:textSize="44sp" />

    <LinearLayout
        android:id="@+id/huntStarsRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/huntFoundButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/kids_calm_bg_big_button_purple"
        android:paddingHorizontal="24dp"
        android:paddingVertical="11dp"
        android:text="@string/kids_calm_adv_hunt_found"
        android:textColor="@color/kids_calm_white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:elevation="8dp"
        android:clickable="true"
        android:focusable="true"
        style="@style/kids_calm_Font.Display" />

</LinearLayout>
