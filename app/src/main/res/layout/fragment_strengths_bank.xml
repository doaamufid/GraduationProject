<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp"
                android:paddingBottom="12dp">

                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_bordered"
                    android:src="@drawable/ic_arrow_right"
                    android:padding="10dp"
                    android:contentDescription="@null"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/strengths_title"
                    android:textColor="@color/text_main"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_title2"
                    android:gravity="start"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <!-- Trait wheel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <FrameLayout
                    android:id="@+id/wheel_container"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_marginBottom="16dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_dashed_circle"/>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="24dp"
                        android:background="@drawable/bg_wheel_center">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/txt_wheel_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_main"
                                android:textStyle="bold"
                                android:textSize="32sp"
                                tools:text="١٢"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/traits_discovered_fmt"
                                android:textColor="@color/text_soft"
                                android:textSize="@dimen/text_tiny"
                                android:visibility="gone"/>
                        </LinearLayout>
                    </FrameLayout>

                    <!-- Up to 3 trait labels placed around the ring, positioned in code -->
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/strengths_bank_heading"
                    android:textColor="@color/text_main"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_h2"
                    android:layout_marginBottom="2dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/strengths_bank_sub"
                    android:textColor="@color/text_soft"
                    android:textSize="@dimen/text_body"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:id="@+id/btn_add_trait"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_pill_light_blue"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/add_trait_button"
                        android:textColor="@color/text_main"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_body"
                        android:layout_marginEnd="4dp"/>

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:src="@drawable/ic_plus"
                        android:contentDescription="@null"
                        app:tint="@color/text_main"
                        xmlns:app="http://schemas.android.com/apk/res-auto"/>
                </LinearLayout>

                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/best_this_month"
                    android:textColor="@color/text_soft"
                    android:textSize="@dimen/text_body"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/traits_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btn_analyze"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="@drawable/bg_button_light_blue"
                android:textColor="@color/text_main"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="@dimen/text_title"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:drawableStart="@drawable/ic_sparkles"
                android:drawablePadding="8dp"
                tools:text="حلل محادثة اليوم الآن"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/overlay_add_trait"
        layout="@layout/overlay_add_trait"/>

</FrameLayout>
