<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:background="@drawable/my_future_msg_bg_sheet_top_rounded"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <FrameLayout
                android:id="@+id/my_future_msg_btn_close_sheet"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentStart="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:src="@drawable/my_future_msg_ic_x"
                    app:tint="@color/my_future_msg_text_soft"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/my_future_msg_tv_sheet_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/my_future_msg_compose_title_new"
                    android:textColor="@color/my_future_msg_text_main"
                    android:textSize="@dimen/my_future_msg_text_size_xlarge"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/my_future_msg_compose_subtitle"
                    android:textColor="@color/my_future_msg_text_soft"
                    android:textSize="@dimen/my_future_msg_text_size_micro"/>
            </LinearLayout>
        </RelativeLayout>

        <EditText
            android:id="@+id/my_future_msg_et_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="5"
            android:gravity="top|end"
            android:textAlignment="viewStart"
            android:hint="@string/my_future_msg_compose_hint"
            android:textColorHint="@color/my_future_msg_text_soft"
            android:textColor="@color/my_future_msg_text_main"
            android:textSize="@dimen/my_future_msg_text_size_medium"
            android:background="@drawable/my_future_msg_bg_textfield"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:inputType="textMultiLine|textCapSentences"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="end"
            android:text="@string/my_future_msg_when_label"
            android:textColor="@color/my_future_msg_text_main"
            android:textSize="@dimen/my_future_msg_text_size_tiny"
            android:textStyle="bold"/>

        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/my_future_msg_chip_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:flexWrap="wrap"
            app:justifyContent="flex_end">

            <TextView
                android:id="@+id/my_future_msg_chip_custom"
                style="@style/my_future_msg_compose_chip"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:drawableStart="@drawable/my_future_msg_ic_calendar"
                android:text="@string/my_future_msg_opt_custom"/>

            <TextView
                android:id="@+id/my_future_msg_chip_week"
                style="@style/my_future_msg_compose_chip"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/my_future_msg_opt_week"/>

            <TextView
                android:id="@+id/my_future_msg_chip_month"
                style="@style/my_future_msg_compose_chip"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/my_future_msg_opt_month"/>

            <TextView
                android:id="@+id/my_future_msg_chip_3m"
                style="@style/my_future_msg_compose_chip"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/my_future_msg_opt_3m"/>

            <TextView
                android:id="@+id/my_future_msg_chip_year"
                style="@style/my_future_msg_compose_chip"
                android:layout_marginBottom="8dp"
                android:text="@string/my_future_msg_opt_year"/>
        </com.google.android.flexbox.FlexboxLayout>

        <TextView
            android:id="@+id/my_future_msg_tv_custom_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/my_future_msg_bg_textfield"
            android:drawableStart="@drawable/my_future_msg_ic_calendar"
            android:drawablePadding="8dp"
            android:gravity="end|center_vertical"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:text="اختر التاريخ"
            android:textColor="@color/my_future_msg_text_soft"
            android:textSize="@dimen/my_future_msg_text_size_medium"
            android:visibility="gone"/>

        <FrameLayout
            android:id="@+id/my_future_msg_btn_save"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/my_future_msg_bg_button_primary_disabled"
            android:enabled="false"
            android:layout_marginTop="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/my_future_msg_tv_save_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/my_future_msg_save_new"
                    android:textColor="@color/my_future_msg_white"
                    android:textSize="@dimen/my_future_msg_text_size_medium"
                    android:textStyle="bold"/>

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/my_future_msg_ic_heart"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</ScrollView>
