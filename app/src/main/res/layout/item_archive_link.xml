<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_bordered"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/img_link_icon_bg"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="9dp"
        android:contentDescription="@null"
        tools:src="@drawable/ic_pen_line"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical"
        android:gravity="start">

        <TextView
            android:id="@+id/txt_link_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_main"
            android:textStyle="bold"
            android:textSize="@dimen/text_title"
            tools:text="أفكاري المتوازنة"/>

        <TextView
            android:id="@+id/txt_link_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_soft"
            android:textSize="@dimen/text_tiny"
            tools:text="من إعادة الصياغة"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/ivArchiveIcon"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:src="@drawable/ic_arrow_right"
        android:contentDescription="@null"/>
</LinearLayout>