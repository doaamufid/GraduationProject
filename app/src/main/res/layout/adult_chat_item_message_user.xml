<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="8dp">

    <!-- user bubbles align to the start (left) per the original CSS .mine { align-self:flex-start } -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginEnd="60dp"
        android:orientation="vertical"
        android:gravity="start">

        <FrameLayout
            android:id="@+id/bubbleTouchWrap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <!-- long-press reaction bar (reply / edit / delete) -->
            <LinearLayout
                android:id="@+id/reactionBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginBottom="46dp"
                android:background="@drawable/adult_chat_bg_reaction_bar"
                android:orientation="horizontal"
                android:padding="5dp"
                android:visibility="gone">

                <TextView android:id="@+id/actReply" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:padding="8dp" android:text="↩ رد" android:textColor="@color/adult_chat_text_mid" android:textSize="11.5sp" android:textStyle="bold" />
                <TextView android:id="@+id/actEdit" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:padding="8dp" android:text="✎ تعديل" android:textColor="@color/adult_chat_text_mid" android:textSize="11.5sp" android:textStyle="bold" />
                <TextView android:id="@+id/actDelete" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:padding="8dp" android:text="🗑 حذف" android:textColor="@color/adult_chat_danger" android:textSize="11.5sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bubbleContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/adult_chat_bg_bubble_user"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <!-- reply-to quote -->
                <LinearLayout
                    android:id="@+id/replyQuote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#26FFFFFF"
                    android:layout_marginBottom="6dp"
                    android:orientation="vertical"
                    android:padding="6dp"
                    android:visibility="gone">
                    <TextView android:id="@+id/txtReplyName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#FFFFFF" android:textSize="10.5sp" android:textStyle="bold" android:alpha="0.9" />
                    <TextView android:id="@+id/txtReplySnippet" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#FFFFFF" android:textSize="11sp" android:alpha="0.8" android:maxLines="1" android:ellipsize="end" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    android:lineSpacingMultiplier="1.3" />

                <!-- voice message row -->
                <LinearLayout
                    android:id="@+id/voiceRow"
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView android:id="@+id/btnVoiceToggle" android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/adult_chat_ic_play" />

                    <FrameLayout android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1"
                        android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:background="#66FFFFFF">
                        <View android:id="@+id/voiceProgressFill" android:layout_width="0dp" android:layout_height="match_parent"
                            android:layout_gravity="start" android:background="#FFFFFFFF" />
                    </FrameLayout>

                    <TextView android:id="@+id/txtVoiceTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0:07" android:textColor="#FFFFFF" android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView android:id="@+id/txtSeen" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="شوهدت 👀" android:textColor="@color/adult_chat_text_faint" android:textSize="10sp" android:visibility="gone" android:layout_marginEnd="4dp"/>
            <ImageView android:id="@+id/imgCheck" android:layout_width="13dp" android:layout_height="13dp"
                android:src="@drawable/adult_chat_ic_check" android:layout_marginEnd="4dp" />
            <TextView android:id="@+id/txtTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/adult_chat_text_faint" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
