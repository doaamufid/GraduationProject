<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootStage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kids_routine_phone_bg"
    android:clipChildren="false"
    tools:context=".KidsRoutineMainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ===== Header: sky journey ===== -->
        <FrameLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/kids_routine_header_padding_h"
                android:paddingEnd="@dimen/kids_routine_header_padding_h"
                android:paddingTop="20dp"
                android:paddingBottom="10dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- top bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <ImageButton
                        android:id="@+id/btnBack"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/kids_routine_bg_icon_btn"
                        android:src="@drawable/kids_routine_ic_arrow_right"
                        android:scaleType="center"
                        android:padding="8dp"
                        android:contentDescription="@string/kids_routine_cd_back"/>

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:gravity="center"
                        android:text="@string/kids_routine_app_name"
                        android:textColor="@color/kids_routine_ink_purple"
                        android:textSize="@dimen/kids_routine_text_title"
                        android:textStyle="bold"
                        android:fontFamily="@font/baloo_variable"/>

                    <LinearLayout
                        android:id="@+id/streakChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/kids_routine_bg_streak_chip"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/kids_routine_ic_flame"/>

                        <TextView
                            android:id="@+id/tvStreak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textColor="@color/kids_routine_ink_purple"
                            android:textSize="@dimen/kids_routine_text_streak"
                            android:textStyle="bold"
                            android:fontFamily="@font/baloo_variable"
                            tools:text="3"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- mascot row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <FrameLayout
                        android:id="@+id/mascotAvatar"
                        android:layout_width="@dimen/kids_routine_mascot_avatar_size"
                        android:layout_height="@dimen/kids_routine_mascot_avatar_size"
                        android:background="@drawable/kids_routine_bg_mascot_avatar"
                        android:elevation="3dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textSize="24sp"
                            android:text="☀️"/>
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/kids_routine_bg_speech_bubble"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp">

                        <TextView
                            android:id="@+id/tvGreeting"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/kids_routine_ink_purple"
                            android:textSize="@dimen/kids_routine_text_speech"
                            android:textStyle="bold"
                            android:lineSpacingMultiplier="1.15"
                            android:fontFamily="@font/baloo_variable"
                            tools:text="صباح النور يا بطل! جاهز نبدأ يومنا؟"/>
                    </FrameLayout>
                </LinearLayout>

                <!-- sky arc journey -->
                <FrameLayout
                    android:id="@+id/arcWrap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/cloud1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="20dp"
                        android:alpha="0.95"
                        android:textSize="18sp"
                        android:text="☁️"/>

                    <TextView
                        android:id="@+id/cloud2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="80dp"
                        android:alpha="0.7"
                        android:textSize="18sp"
                        android:text="☁️"/>

                    <com.example.graduationproject.view.KidsRoutineSkyArcView
                        android:id="@+id/skyArcView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="4dp"
                        android:gravity="center"
                        android:textColor="@color/kids_routine_ink_purple"
                        android:textSize="@dimen/kids_routine_text_progress"
                        android:textStyle="bold"
                        android:fontFamily="@font/cairo_variable"
                        tools:text="٠ من ٩ خطوات"/>

                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- ===== Scrollable routine list ===== -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/kids_routine_content_padding_h"
                android:paddingEnd="@dimen/kids_routine_content_padding_h"
                android:paddingTop="16dp">

                <!-- sticker shelf -->
                <LinearLayout
                    android:id="@+id/stickerShelf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/kids_routine_bg_sticker_shelf"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/kids_routine_your_stars"
                        android:textColor="@color/kids_routine_muted_purple"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/cairo_variable"/>

                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:scrollbars="none"
                        android:overScrollMode="never">

                        <LinearLayout
                            android:id="@+id/stickerRow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"/>
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- dynamically populated: period headers + routine cards -->
                <LinearLayout
                    android:id="@+id/routineListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"/>

                <!-- empty state -->
                <LinearLayout
                    android:id="@+id/emptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="40dp"
                    android:paddingBottom="40dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="46sp"
                        android:layout_marginBottom="10dp"
                        android:text="🌤️"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/kids_routine_empty_title"
                        android:textColor="@color/kids_routine_muted_purple"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:lineSpacingMultiplier="1.3"
                        android:fontFamily="@font/cairo_variable"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="90dp"/>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- ===== floating bottom bar ===== -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:elevation="8dp"
        android:padding="10dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageButton
            android:id="@+id/btnEdit"
            android:layout_width="@dimen/kids_routine_small_fab_size"
            android:layout_height="@dimen/kids_routine_small_fab_size"
            android:background="@drawable/kids_routine_bg_small_fab"
            android:src="@drawable/kids_routine_ic_pencil"
            android:scaleType="center"
            android:padding="12dp"
            android:contentDescription="@string/kids_routine_cd_edit"
            android:elevation="4dp"/>

        <ImageButton
            android:id="@+id/btnReset"
            android:layout_width="@dimen/kids_routine_small_fab_size"
            android:layout_height="@dimen/kids_routine_small_fab_size"
            android:layout_marginStart="14dp"
            android:background="@drawable/kids_routine_bg_small_fab"
            android:src="@drawable/kids_routine_ic_reset"
            android:scaleType="center"
            android:padding="12dp"
            android:contentDescription="@string/kids_routine_cd_reset"
            android:elevation="4dp"/>

        <ImageButton
            android:id="@+id/btnAdd"
            android:layout_width="@dimen/kids_routine_main_fab_size"
            android:layout_height="@dimen/kids_routine_main_fab_size"
            android:layout_marginStart="14dp"
            android:background="@drawable/kids_routine_bg_main_fab"
            android:src="@drawable/kids_routine_ic_plus"
            android:scaleType="center"
            android:padding="16dp"
            android:contentDescription="@string/kids_routine_cd_add"
            android:elevation="6dp"/>

    </LinearLayout>

</FrameLayout>
