<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="220dp"
    android:layout_margin="12dp"
    app:cardCornerRadius="28dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="@android:color/black"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:layoutDirection="locale">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Background Image -->
        <ImageView
            android:id="@+id/ivCardBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/fireplace"
            tools:src="@tools:sample/backgrounds/scenic" />

        <!-- Hazy/White bottom gradient for text contrast -->
        <View
            android:id="@+id/bottomScrim"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:background="@drawable/bg_bottom_scrim"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Top Start: Brand/Logo (NASA style) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvBrandLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NASA"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                tools:text="NASA" />
        </LinearLayout>

        <!-- Top End Actions: Love and Bookmark (Left in RTL) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_heart_outline"
                app:tint="#FFFFFF"
                android:contentDescription="@string/fav_content" />

            <ImageButton
                android:id="@+id/btnBookmark"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_bookmark_outline"
                app:tint="#FFFFFF"
                android:contentDescription="@string/bookmark_content" />
        </LinearLayout>

        <!-- Bottom Start: Main Title, Minutes & Subtitle -->
        <LinearLayout
            android:id="@+id/llBottomText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="24dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnLearnMore"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/tvMainTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apollo 11"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Apollo 11" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="31:40"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                tools:text="31:40" />

            <TextView
                android:id="@+id/tvSubTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="One small step for man, one giant leap for mankind."
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:alpha="0.85"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="One small step for man, one giant leap for mankind." />
        </LinearLayout>

        <!-- Bottom End: Watch Now Pill Button -->
        <TextView
            android:id="@+id/btnLearnMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_dark_pill_button"
            android:paddingHorizontal="18dp"
            android:paddingVertical="8dp"
            android:text="@string/watch_now"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Watch now" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
