<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Status row -->
    <TextView
        android:id="@+id/tvStatusClock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="14dp"
        android:paddingBottom="4dp"
        android:textColor="@color/text_main"
        android:textStyle="bold"
        android:textSize="12sp"/>

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_arrow_right"
            android:padding="11dp"
            android:contentDescription="@null"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- ===================== HERO CARD (The Player Card) ===================== -->
            <androidx.cardview.widget.CardView
                android:id="@+id/heroCardRoot"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#000000">

                <FrameLayout
                    android:id="@+id/heroCard"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/heroScene"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@null"/>

                    <!-- Gradient Overlay for the "blurred" text area effect -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_hero_card_overlay"/>

                    <TextView
                        android:id="@+id/tvEnvBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|right"
                        android:layout_margin="16dp"
                        android:background="@drawable/bg_badge_overlay"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        tools:text="غابة هادئة · FOREST"/>

                    <!-- Status Indicator (Playing/Paused) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|left"
                        android:layout_margin="16dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_badge_overlay"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp">

                        <View
                            android:id="@+id/statusDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_status_dot_paused"/>

                        <TextView
                            android:id="@+id/tvStatusLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            tools:text="قيد التشغيل"/>
                    </LinearLayout>

                    <!-- Center Play/Pause -->
                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center">
                        <View
                            android:id="@+id/heroPulseRing"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_pulse_ring"
                            android:visibility="gone"/>
                        <ImageButton
                            android:id="@+id/btnHeroPlayPause"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_play_button_overlay"
                            android:src="@drawable/ic_pause"
                            app:tint="@color/white"
                            android:padding="19dp"
                            android:contentDescription="@null"/>
                    </FrameLayout>

                    <!-- Bottom Controls inside the card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Scrubber inside card -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp">

                            <TextView
                                android:id="@+id/tvElapsed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#B3FFFFFF"
                                android:textSize="10sp"
                                tools:text="٠:٠٠"/>

                            <FrameLayout
                                android:id="@+id/scrubberTrack"
                                android:layout_width="0dp"
                                android:layout_height="4dp"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:layout_marginEnd="8dp"
                                android:background="#4DFFFFFF">
                                <View
                                    android:id="@+id/scrubberFill"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:background="@color/white"/>
                            </FrameLayout>

                            <TextView
                                android:id="@+id/tvTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#B3FFFFFF"
                                android:textSize="10sp"
                                tools:text="١٠:٥٢"/>
                        </LinearLayout>

                        <!-- Transport & Timer Status -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:id="@+id/llTransport"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_alignParentStart="true"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageButton
                                    android:id="@+id/btnPrev"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:src="@drawable/ic_skip_back"
                                    app:tint="@color/white"
                                    android:padding="10dp"
                                    android:contentDescription="@null"/>

                                <ImageButton
                                    android:id="@+id/btnPlayPause"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:layout_marginStart="12dp"
                                    android:layout_marginEnd="12dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:src="@drawable/ic_pause"
                                    app:tint="@color/white"
                                    android:padding="12dp"
                                    android:contentDescription="@null"/>

                                <ImageButton
                                    android:id="@+id/btnNext"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:src="@drawable/ic_skip_forward"
                                    app:tint="@color/white"
                                    android:padding="10dp"
                                    android:contentDescription="@null"/>
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvTimerStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:layout_toEndOf="@id/llTransport"
                                android:gravity="end"
                                android:textColor="@color/white"
                                android:textStyle="bold"
                                android:textSize="10sp"
                                tools:text="TIMER · ٣٠ د متبقية"/>
                        </RelativeLayout>
                    </LinearLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===================== ENDED MESSAGE ===================== -->
            <TextView
                android:id="@+id/tvEndedMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ended_card"
                android:padding="12dp"
                android:gravity="center"
                android:text="@string/ended_message"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="20dp"
                android:visibility="gone"/>

            <!-- ===================== ENVIRONMENT PICKER ===================== -->
            <LinearLayout
                android:id="@+id/llEnvPicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp"/>

            <!-- ===================== SLEEP TIMER CHIPS ===================== -->
            <LinearLayout
                android:id="@+id/llTimerChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:paddingBottom="12dp"
                android:clipToPadding="false"
                android:clipChildren="false"/>

            <!-- Active Timer Tracker Card -->
            <include layout="@layout/layout_timer_active_card" />

            <!-- ===================== SOUND LAYERS ===================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="@string/layers_section_title"
                android:textColor="@color/text_soft"
                android:textStyle="bold"
                android:textSize="11sp"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:id="@+id/llLayers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
