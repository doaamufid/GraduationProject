<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/chat_card_max_width"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_suggestion_card"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:text="@string/chat_article_tag"
        android:background="@drawable/bg_tag_pill"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textColor="@color/text_soft"
        android:textStyle="bold"
        android:textSize="9sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/chat_article_title"
        android:textColor="@color/text_main"
        android:textStyle="bold"
        android:textSize="@dimen/chat_text_body"
        android:lineSpacingMultiplier="1.15"
        android:gravity="start"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/btn_card_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:text="@string/chat_article_button"
        android:textColor="@color/primary"
        android:textStyle="bold"
        android:textSize="@dimen/chat_text_chip"
        android:clickable="true"
        android:focusable="true"
        android:padding="2dp"/>

</LinearLayout>
