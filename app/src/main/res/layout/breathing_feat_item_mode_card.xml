<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_hub_item"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal"
    android:padding="16dp">

    <TextView
        android:id="@+id/modeCardIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_pill_accent"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="18sp"
        tools:text="▢" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/modeCardName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/hub_title"
            android:textSize="15.5sp"
            android:textStyle="bold"
            tools:text="تنفس المربع" />

        <TextView
            android:id="@+id/modeCardDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:textColor="@color/hub_desc"
            android:textSize="12sp"
            tools:text="تنفس المربع طريقة قوية لتقليل التوتر" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/modeCardRatio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:textColor="@color/hub_title"
                android:textStyle="bold"
                android:textSize="13.5sp"
                tools:text="4-4-4-4" />

            <TextView
                android:id="@+id/modeCardStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_pill_accent"
                android:paddingHorizontal="18dp"
                android:paddingVertical="7dp"
                android:text="جربيه الآن ✨"
                android:textColor="@color/white"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <TextView
            android:id="@+id/modeCardDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/hub_desc"
            android:textSize="11sp"
            tools:text="⏱ 4 دقائق" />
    </LinearLayout>
</LinearLayout>
