<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="24dp">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="12dp">

        <View
            android:id="@+id/badgeIconBg"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_badge_icon_circle"/>

        <ImageView
            android:id="@+id/ivBadgeIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            tools:src="@drawable/ic_flame"
            android:contentDescription="@null"/>
    </FrameLayout>

    <TextView
        android:id="@+id/tvBadgeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_main"
        android:textStyle="bold"
        android:textSize="15sp"
        android:layout_marginBottom="4dp"
        tools:text="أسبوع كامل"/>

    <TextView
        android:id="@+id/tvBadgeStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_soft"
        android:textSize="12sp"
        android:layout_marginBottom="16dp"
        tools:text="أنجزتها بالفعل 🎉"/>

    <TextView
        android:id="@+id/btnClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_primary"
        android:text="@string/close_btn"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="12sp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:clickable="true"
        android:focusable="true"/>

</LinearLayout>
